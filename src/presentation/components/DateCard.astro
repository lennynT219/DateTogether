---
import type { DateEntry } from '../../core/entities/DateEntry';

export interface Props {
  date: DateEntry;
}
const { date } = Astro.props;
const isCompleted = date.completed;
const isFree = date.category === 'free';
const displayTitle = isFree ? 'Espacio libre' : date.title;
const dateNumber = String(date.orderIndex).padStart(2, '0');
---

<article
  class="date-card"
  data-date-id={date.id}
  data-completed={String(isCompleted)}
  data-category={date.category}
>
  <div class="date-card__media">
    {
      isCompleted ? (
        <div class="date-card__icon date-card__icon--completed">
          <svg
            aria-hidden="true"
            focusable="false"
            viewBox="0 0 24 24"
            width="40"
            height="40"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
          </svg>
        </div>
      ) : (
        <div class="date-card__icon date-card__icon--locked">
          <svg
            aria-hidden="true"
            focusable="false"
            viewBox="0 0 24 24"
            width="32"
            height="32"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
        </div>
      )
    }
  </div>
  <div class="date-card__info">
    <span class="date-card__number">Cita {dateNumber}</span>
    <h3 class="date-card__title">{displayTitle}</h3>
    <span
      class={`date-card__badge ${isCompleted ? 'date-card__badge--completed' : 'date-card__badge--pending'}`}
    >
      {isCompleted ? 'Completada' : 'Pendiente'}
    </span>
  </div>
</article>

<style>
  .date-card {
    position: relative;
    display: flex;
    flex-direction: column;
    isolation: isolate;
    aspect-ratio: var(--date-card-aspect-ratio, 3 / 4);
    overflow: var(--date-card-overflow, hidden);
    background: var(--date-card-background, #fbf7ef);
    border: var(--date-card-border, 1px solid rgba(62, 42, 30, 0.16));
    border-radius: var(--date-card-radius, var(--radius-lg, 0.75rem));
    box-shadow: var(--date-card-shadow, var(--shadow-card, 0 8px 24px rgba(8, 5, 3, 0.2)));
  }

  .date-card__media {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    background: var(
      --date-card-media-background,
      linear-gradient(rgba(62, 42, 30, 0.04) 1px, transparent 1px),
      #eee5d7
    );
    background-size: var(--date-card-media-background-size, 100% 1.5rem);
  }

  .date-card[data-category='free'] .date-card__media {
    background: var(
      --date-card-free-media-background,
      radial-gradient(circle at center, rgba(196, 168, 130, 0.28), transparent 62%),
      #f3eadc
    );
  }

  .date-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .date-card__icon--locked {
    color: var(--date-card-locked-color, #5f5041);
  }
  .date-card__icon--completed {
    color: var(--date-card-completed-color, #75452f);
  }
  .date-card__info {
    display: flex;
    flex-direction: column;
    gap: var(--date-card-info-gap, 0.35rem);
    padding: var(--date-card-info-padding, clamp(0.65rem, 2vw, 0.9rem) clamp(0.7rem, 2vw, 1rem));
    background: var(--date-card-info-background, #fbf7ef);
    border-top: var(--date-card-info-border, 1px solid rgba(62, 42, 30, 0.1));
  }
  .date-card__number {
    color: var(--date-card-number-color, #765f4b);
    font-size: var(--date-card-number-size, 0.64rem);
    font-weight: 700;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .date-card__title {
    font-family: var(--font-family-display, Georgia, serif);
    font-size: var(--date-card-title-size, clamp(0.84rem, 2vw, 1rem));
    font-weight: 700;
    color: var(--date-card-title-color, #3e2a1e);
    margin: 0;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .date-card__badge {
    font-size: var(--date-card-badge-size, 0.68rem);
    font-weight: 700;
    padding: var(--date-card-badge-padding, 0.24rem 0.55rem);
    border-radius: var(--date-card-badge-radius, 999px);
    align-self: flex-start;
  }
  .date-card__badge--pending {
    background: var(--date-card-pending-background, #e8dcc8);
    color: var(--date-card-pending-color, #56391f);
  }
  .date-card__badge--completed {
    background: var(--date-card-completed-background, #dce7d7);
    color: var(--date-card-completed-badge-color, #2f5a38);
  }
</style>
