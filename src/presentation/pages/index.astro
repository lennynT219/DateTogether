    border-top-color: #d3b66c;
    border-right-color: #a47f3b;
    border-bottom-color: #513914;
    border-left-color: #bea052;
    border-radius: 999px;
    background: transparent;
    box-shadow:
      inset 0 1px 1px rgba(255, 245, 197, 0.45),
      0 0.14rem 0.16rem rgba(20, 10, 5, 0.6),
      0 0.3rem 0.45rem rgba(20, 10, 5, 0.23);
    transform: rotateX(52deg) rotateZ(-0.5deg);
  }

  .album-ring:nth-child(3n + 2) {
    transform: rotateX(54deg) rotateZ(0.7deg);
  }

  .album-ring:nth-child(3n) {
    filter: brightness(0.9);
    transform: rotateX(50deg) rotateZ(-0.2deg);
  }

  .album-object :global(.album-endpaper) {
    position: relative;
    z-index: 2;
    display: grid;
    place-content: center;
    justify-items: center;
    min-height: 0;
    padding: 2rem 1rem;
    text-align: center;
  }

  .album-object :global(.album-endpaper)::before,
  .album-object :global(.album-endpaper)::after {
    content: '';
    width: min(10rem, 70%);
    height: 1px;
    margin: 0.7rem 0;
    background: linear-gradient(90deg, transparent, rgba(91, 61, 38, 0.48), transparent);
  }

  .album-object :global(.album-endpaper__ornament) {
    color: #896735;
    font-size: 1rem;
  }

  .album-object :global(.album-endpaper p) {
    margin: 0.55rem 0 0.25rem;
    color: #483124;
    font-family: var(--font-family-display, Georgia, serif);
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-style: italic;
    line-height: 1.12;
    text-wrap: balance;
  }

  .album-object :global(.album-endpaper > span:last-child) {
    color: #765c43;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .album-object :global(.album-leaf__footer--endpaper) {
    justify-content: center;
  }

  #album-motion-host {
    position: absolute;
    z-index: 24;
    inset: 0;
    transform-style: preserve-3d;
    pointer-events: none;
  }

  #album-motion-host:empty {
    display: none;
  }

  #album-motion-host :global(.album-turn) {
    position: absolute;
    z-index: 25;
    top: 0;
    bottom: 0;
    transform-style: preserve-3d;
  }

  #album-motion-host :global(.album-turn--next) {
    right: 0;
    left: calc(50% + var(--album-gutter) / 2);
    transform-origin: left center;
  }

  #album-motion-host :global(.album-turn--prev) {
    right: calc(50% + var(--album-gutter) / 2);
    left: 0;
    transform-origin: right center;
  }

  #album-motion-host :global(.album-turn__face) {
    position: absolute;
    inset: 0;
    height: 100%;
    overflow: visible;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transform-style: preserve-3d;
  }

  #album-motion-host :global(.album-turn__face--front) {
    box-shadow:
      inset -0.65rem 0 1.2rem -0.9rem rgba(63, 35, 18, 0.34),
      0 0 0.45rem rgba(39, 20, 10, 0.18);
    transform: rotateY(0deg) translateZ(0.25px);
  }

  #album-motion-host :global(.album-turn__face--back) {
    background:
      linear-gradient(90deg, rgba(94, 57, 29, 0.3), transparent 26%, rgba(80, 48, 25, 0.18)),
      radial-gradient(ellipse at 72% 18%, rgba(255, 235, 198, 0.22), transparent 38%),
      repeating-linear-gradient(
        8deg,
        rgba(99, 64, 35, 0.045) 0,
        rgba(99, 64, 35, 0.045) 1px,
        transparent 1px,
        transparent 10px
      ),
      #d8c19d;
    box-shadow:
      inset 1.3rem 0 1.7rem -1.2rem rgba(64, 36, 19, 0.56),
      inset 0 0 2rem rgba(91, 55, 30, 0.14);
    transform: rotateY(180deg) translateZ(0.25px);
  }

  #album-motion-host :global(.album-turn--next.is-turning) {
    will-change: transform;
    animation: album-turn-next var(--turn-duration) cubic-bezier(0.2, 0.72, 0.18, 1) forwards;
  }

  #album-motion-host :global(.album-turn--prev.is-turning) {
    will-change: transform;
    animation: album-turn-prev var(--turn-duration) cubic-bezier(0.2, 0.72, 0.18, 1) forwards;
  }

  @keyframes album-turn-next {
    0% {
      transform: rotateY(0deg) translateZ(0);
    }
    46% {
      transform: rotateY(-78deg) translateZ(1.1rem);
    }
    70% {
      transform: rotateY(-132deg) translateZ(0.45rem);
    }
    100% {
      transform: rotateY(-180deg) translateZ(0);
    }
  }

  @keyframes album-turn-prev {
    0% {
      transform: rotateY(0deg) translateZ(0);
    }
    46% {
      transform: rotateY(78deg) translateZ(1.1rem);
    }
    70% {
      transform: rotateY(132deg) translateZ(0.45rem);
    }
    100% {
      transform: rotateY(180deg) translateZ(0);
    }
  }

  #album-motion-host :global(.album-turn-shadow) {
    position: absolute;
    z-index: 23;
    top: -0.55rem;
    bottom: -0.7rem;
    opacity: 0;
    filter: blur(0.7rem);
    pointer-events: none;
  }

  #album-motion-host :global(.album-turn-shadow--next) {
    right: calc(50% + var(--album-gutter) / 2);
    left: 0;
    background: linear-gradient(
      90deg,
      transparent 4%,
      rgba(38, 20, 11, 0.1) 38%,
      rgba(38, 20, 11, 0.46) 88%,
      rgba(38, 20, 11, 0.28)
    );
    transform-origin: right center;
  }

  #album-motion-host :global(.album-turn-shadow--prev) {
    right: 0;
    left: calc(50% + var(--album-gutter) / 2);
    background: linear-gradient(
      90deg,
      rgba(38, 20, 11, 0.28),
      rgba(38, 20, 11, 0.46) 12%,
      rgba(38, 20, 11, 0.1) 62%,
      transparent 96%
    );
    transform-origin: left center;
  }

  #album-motion-host :global(.album-turn-shadow.is-moving) {
    will-change: transform, opacity;
    animation: album-travelling-shadow var(--turn-duration) cubic-bezier(0.25, 0.65, 0.25, 1) both;
  }

  @keyframes album-travelling-shadow {
    0%,
    100% {
      opacity: 0;
      transform: scaleX(0.08);
    }
    42% {
      opacity: 0.72;
      transform: scaleX(0.5);
    }
    68% {
      opacity: 0.35;
      transform: scaleX(1);
    }
  }

  .album-controls {
    position: relative;
    z-index: 7;
    display: grid;
    grid-template-columns: minmax(7rem, 1fr) minmax(12rem, auto) minmax(7rem, 1fr);
    align-items: center;
    gap: clamp(0.55rem, 1.6vw, 1rem);
    margin-top: clamp(0.85rem, 1.8vw, 1.2rem);
    padding: 0.5rem clamp(0.45rem, 1.2vw, 0.8rem);
    background: rgba(26, 13, 8, 0.42);
    border: 1px solid rgba(203, 159, 101, 0.28);
    border-radius: 0.28rem;
    box-shadow:
      inset 0 1px 0 rgba(255, 235, 205, 0.05),
      0 0.25rem 0.45rem rgba(10, 5, 3, 0.22);
    opacity: var(--controls-opacity);
    transform: translateY(var(--controls-y));
  }

  .album-controls__button {
    min-width: 0;
    min-height: 2.75rem;
    padding: 0.58rem 0.85rem;
    color: #ead9bd;
    background: linear-gradient(rgba(255, 255, 255, 0.035), transparent), rgba(78, 48, 29, 0.72);
    border: 1px solid rgba(210, 170, 112, 0.52);
    border-radius: 0.18rem;
    box-shadow:
      inset 0 0 0 1px rgba(29, 15, 9, 0.4),
      0 0.18rem 0.3rem rgba(9, 4, 2, 0.3);
    font-family: var(--font-family-display, Georgia, serif);
    font-size: clamp(0.76rem, 1.2vw, 0.9rem);
    font-weight: 700;
    letter-spacing: 0.025em;
    text-align: center;
    transition:
      border-color 160ms ease,
      background 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .album-controls__button:first-child {
    justify-self: start;
  }

  .album-controls__button:last-child {
    justify-self: end;
  }

  .album-controls__button:hover:not(:disabled):not([aria-disabled='true']) {
    color: #fff4df;
    background: rgba(104, 66, 39, 0.78);
    border-color: #d0aa70;
    transform: translateY(-1px);
  }

  .album-controls__button:disabled,
  .album-controls__button[aria-disabled='true'] {
    color: #a28d70;
    background: rgba(47, 29, 18, 0.58);
    border-color: rgba(168, 132, 84, 0.28);
    box-shadow: inset 0 0 0 1px rgba(29, 15, 9, 0.28);
    opacity: 0.68;
  }

  .album-controls__button:focus-visible {
    outline: 3px solid #f1cb86;
    outline-offset: 3px;
  }

  .album-controls__indicator {
    color: #d7bd93;
    font-size: clamp(0.68rem, 1.1vw, 0.82rem);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.055em;
    line-height: 1.35;
    text-align: center;
    text-transform: uppercase;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1180px) {
    :global(html:has(.dashboard__summary:is(.is-album-hud, .is-grid-hud))) {
      scroll-padding-top: 5.5rem;
    }

    .dates-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .album-story__scene {
      padding: 5.4rem 4.15rem 0.55rem 0.35rem;
    }

    .album-story__annotation--opening {
      top: 6.2rem;
      left: 0.75rem;
    }

    .album-story__final-note {
      top: max(5.25rem, calc(env(safe-area-inset-top) + 4.85rem));
      left: max(0.75rem, calc(env(safe-area-inset-left) + 0.5rem));
      width: min(18rem, calc(100% - 6.5rem));
    }

    .album-story__annotation--closing {
      right: 4.6rem;
    }

    .book-view[data-story-enabled='true'] .album-story__phrase--one {
      top: 6.2rem;
      right: 4.6rem;
      left: auto;
      max-width: 13rem;
      text-align: right;
    }

    .book-view[data-story-enabled='true'] .album-story__phrase--three {
      bottom: 1.25%;
      left: 0.75rem;
      max-width: 15rem;
    }

    .book-view[data-story-enabled='true']
      .album-story__phrase:is(.album-story__phrase--two, .album-story__phrase--four) {
      display: none;
    }

    .album-spread {
      min-height: clamp(26rem, 52vw, 38rem);
      min-height: clamp(26rem, min(52vw, calc(100dvh - 11rem)), 38rem);
    }

    .dashboard__summary:is(.is-album-hud, .is-grid-hud) {
      --time-counter-value-size: 0.8rem;
      top: max(0.5rem, env(safe-area-inset-top));
      right: max(0.75rem, env(safe-area-inset-right));
      left: max(0.75rem, env(safe-area-inset-left));
      grid-template-columns: minmax(0, 1.2fr) minmax(12rem, 0.8fr);
      gap: 0.75rem;
      width: auto;
      max-height: none;
      padding: 0.55rem 0.7rem;
      transform: translate3d(0, var(--summary-mobile-y, -1.5rem), 0)
        scale(var(--summary-scale, 0.88));
      transform-origin: top center;
    }

    .dashboard__summary:is(.is-album-hud, .is-grid-hud)
      .dashboard__summary-counter
      :global(.time-counter) {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .dashboard__summary:is(.is-album-hud, .is-grid-hud) .dashboard__summary-progress {
      padding-top: 0;
      padding-left: 0.75rem;
      border-top: 0;
      border-left: 1px solid rgba(232, 220, 200, 0.18);
    }

    .dashboard__main :where([id], button, a, [tabindex]) {
      scroll-margin-top: 6rem;
    }
  }

  @media (max-width: 900px) {
    .dates-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .dashboard__summary {
      grid-template-columns: minmax(0, 1fr);
    }

    .dashboard__summary-progress {
      padding-top: 1.5rem;
      padding-left: 0;
      border-top: 1px solid rgba(232, 220, 200, 0.2);
      border-left: none;
    }

    .album-object {
      --date-card-info-padding: 0.48rem;
    }
  }

  @media (max-width: 768px) {
    .dashboard__masthead,
    .dashboard__toolbar {
      flex-direction: column;
      align-items: flex-start;
    }

    .dashboard__summary:is(.is-album-hud, .is-grid-hud) {
      --time-counter-gap: 0.12rem;
      --time-counter-value-size: 0.72rem;
      --time-counter-label-size: 0.44rem;
      --time-counter-label-margin: 0.04rem;
      --progress-header-margin: 0.2rem;
      --progress-percentage-size: 0.68rem;
      --progress-track-height: 0.28rem;
      top: max(0.35rem, env(safe-area-inset-top));
      right: max(0.5rem, env(safe-area-inset-right));
      left: max(0.5rem, env(safe-area-inset-left));
      grid-template-columns: minmax(0, 1.55fr) minmax(5.25rem, 0.45fr);
      gap: 0.45rem;
      padding: 0.45rem 0.5rem;
      border-radius: 0.32rem;
    }

    .dashboard__summary:is(.is-album-hud, .is-grid-hud) .dashboard__summary-progress {
      padding-left: 0.45rem;
    }

    .dashboard__summary:is(.is-album-hud, .is-grid-hud) :global(.progress-bar__label) {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .dashboard__summary:is(.is-album-hud, .is-grid-hud) :global(.progress-bar__header) {
      justify-content: flex-end;
    }

    .grid-archive {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.9rem;
      padding: clamp(0.65rem, 3vw, 0.9rem);
      background-size:
        3.75rem 100%,
        100% 3.75rem,
        auto;
    }

    .dates-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      --grid-item-gap: 0.6rem;
    }

    .grid-archive__guide {
      position: relative;
      top: auto;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto 1px;
      gap: 0.22rem;
      width: 100%;
      padding-bottom: 0.35rem;
    }

    .grid-archive__guide-kicker,
    .grid-archive__guide-count,
    .grid-archive__guide-line {
      grid-column: 1;
    }

    .grid-archive__guide-line {
      grid-row: 3;
      width: 100%;
      height: 1px;
      margin: 0;
    }

    .grid-archive__guide-fill {
      transform: scaleX(var(--grid-progress));
      transform-origin: left;
    }

    .album-story__scene {
      padding: 4.85rem 2.65rem 0.4rem 0.15rem;
    }

    .album-story__rail {
      right: 0.15rem;
      grid-template-columns: 0.55rem minmax(0, 1fr);
      grid-template-rows: auto 8.5rem;
      gap: 0.45rem 0.42rem;
      width: 2.2rem;
    }

    .album-story__rail p {
      position: absolute;
      top: -2.35rem;
      right: 0;
      width: 7.5rem;
      font-size: 0.6rem;
      text-align: right;
      transform: none;
    }

    .album-story__final-note {
      top: max(6.35rem, calc(env(safe-area-inset-top) + 5.85rem));
      left: max(0.5rem, calc(env(safe-area-inset-left) + 0.35rem));
      width: min(16rem, calc(100% - 3.75rem));
      font-size: clamp(0.78rem, 3.45vw, 0.98rem);
      line-height: 1.16;
    }

    .album-story__annotation--opening {
      display: none;
    }

    .album-story__annotation--closing {
      right: 2.75rem;
      bottom: 1.25%;
      max-width: 12rem;
      font-size: 0.67rem;
    }

    .book-view[data-story-enabled='true'] .album-story__phrases {
      display: none;
    }

    .book-view[data-story-enabled='false']
      .album-story__phrase:is(.album-story__phrase--three, .album-story__phrase--four) {
      display: none;
    }

    .dashboard__view-toggle {
      max-width: 100%;
    }

    .view-btn {
      min-width: 0;
      padding-inline: 0.9rem;
    }

    .album-stage {
      width: min(100%, 44rem);
    }

    .album-object {
      --date-card-title-size: clamp(0.75rem, 2.5vw, 1rem);
      --date-card-number-size: clamp(0.54rem, 1.7vw, 0.64rem);
      --date-card-badge-size: clamp(0.54rem, 1.65vw, 0.62rem);
    }

    .album-spread {
      grid-template-columns: var(--album-mobile-gutter) minmax(0, 1fr);
      min-height: clamp(23.5rem, 92vw, 38rem);
      min-height: clamp(23.5rem, min(92vw, calc(100dvh - 10.5rem)), 38rem);
    }

    .album-page-stack--left {
      right: 0.14rem;
      left: calc(var(--album-mobile-gutter) + 0.12rem);
      transform: rotateZ(0.08deg);
    }

    .album-page-stack--right,
    .album-leaf--right {
      display: none;
    }

    .album-leaf--left {
      grid-column: 2;
      border-radius: 0.05rem 0.4rem 0.45rem 0.12rem;
      box-shadow:
        inset 1.2rem 0 1.5rem -1.15rem rgba(42, 24, 14, 0.72),
        inset -0.15rem 0 0.5rem rgba(255, 255, 255, 0.24),
        0 0.1rem 0.18rem rgba(40, 23, 13, 0.25);
    }

    .album-leaf--left .album-leaf__holes {
      right: auto;
      left: -0.38rem;
    }

    #album-motion-host :global(.album-turn__holes),
    #album-motion-host :global(.album-turn--prev .album-turn__holes) {
      right: auto;
      left: -0.38rem;
    }

    .album-leaf--left :global(.album-leaf__folio) {
      order: initial;
    }

    .album-leaf--left :global(.album-leaf__annotation) {
      order: initial;
      text-align: left;
    }

    .album-trough {
      grid-column: 1;
    }

    .album-rings {
      left: calc(var(--album-mobile-gutter) / 2);
      width: clamp(2.2rem, 11vw, 3rem);
    }

    .album-paper-block {
      left: calc(1.35rem + var(--album-mobile-gutter));
    }

    .album-paper-block__outside--left {
      display: none;
    }

    #album-motion-host :global(.album-turn--next),
