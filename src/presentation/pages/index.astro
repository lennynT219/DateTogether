    border-left: 0.45rem solid var(--color-primary, #8b6f47);
    border-radius: 0.25rem var(--radius-lg, 0.75rem) var(--radius-lg, 0.75rem) 0.25rem;
    box-shadow: var(--shadow-paper, 0 18px 45px rgba(8, 5, 3, 0.24));
  }

  .dashboard__notice h2 {
    margin: 0.35rem 0 0.6rem;
    font-family: var(--font-family-display, Georgia, serif);
    font-size: clamp(1.5rem, 5vw, 2.25rem);
    line-height: 1.1;
    text-wrap: balance;
  }

  .dashboard__notice p:last-child {
    max-width: 58ch;
    color: var(--color-ink-soft, #6a5847);
  }

  .dashboard__toolbar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(232, 220, 200, 0.18);
  }

  .dashboard__toolbar h2 {
    margin-top: 0.2rem;
    color: #f3e8d6;
    font-family: var(--font-family-display, Georgia, serif);
    font-size: clamp(1.4rem, 4vw, 2rem);
    line-height: 1.15;
  }

  /* ===== View Toggle ===== */
  .dashboard__view-toggle {
    display: flex;
    flex: 0 0 auto;
    padding: 0.2rem;
    background: var(--color-canvas-raised, #241a14);
    border: 1px solid rgba(232, 220, 200, 0.32);
    border-radius: var(--radius-lg, 0.75rem);
    overflow: hidden;
  }

  .view-btn {
    min-height: 2.75rem;
    background: transparent;
    border: none;
    color: var(--color-accent, #c4a882);
    padding: 0.55rem 1rem;
    border-radius: calc(var(--radius-lg, 0.75rem) - 0.2rem);
    font-size: 0.85rem;
    font-weight: 700;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .view-btn:hover {
    color: #fff7e9;
    background: rgba(196, 168, 130, 0.12);
  }

  .view-btn--active,
  .view-btn[aria-pressed='true'] {
    background: var(--color-paper-aged, #e8dcc8);
    color: var(--color-leather, #3e2a1e);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  /* ===== Logout ===== */
  .dashboard__logout {
    min-height: 2.75rem;
    flex: 0 0 auto;
    background: transparent;
    border: 1px solid rgba(232, 220, 200, 0.35);
    color: #d2c2aa;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-md, 0.5rem);
    font-size: 0.85rem;
    font-weight: 600;
    transition:
      border-color 0.2s,
      background 0.2s,
      color 0.2s;
  }

  .dashboard__logout:hover {
    border-color: var(--color-accent, #c4a882);
    background: rgba(196, 168, 130, 0.1);
    color: #fff7e9;
  }

  /* ===== Grid View ===== */
  .grid-archive {
    --grid-progress: 0;
    --grid-depth-y: 1.4rem;
    --grid-light-x: 18%;
    position: relative;
    display: grid;
    grid-template-columns: minmax(5.5rem, 7rem) minmax(0, 1fr);
    gap: clamp(1rem, 2.4vw, 2rem);
    min-width: 0;
    padding: clamp(0.9rem, 2.4vw, 1.6rem);
    overflow: clip;
    background:
      linear-gradient(90deg, rgba(229, 201, 158, 0.045) 1px, transparent 1px),
      linear-gradient(rgba(229, 201, 158, 0.035) 1px, transparent 1px),
      rgba(20, 14, 10, 0.18);
    background-position:
      center calc(50% + var(--grid-depth-y)),
      center calc(50% + var(--grid-depth-y)),
      center;
    background-size:
      4.5rem 100%,
      100% 4.5rem,
      auto;
    border: 1px solid rgba(232, 220, 200, 0.1);
    border-radius: 0.28rem;
    isolation: isolate;
  }

  .grid-archive::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -12% -8%;
    opacity: 0.46;
    background: radial-gradient(
      circle at var(--grid-light-x) 34%,
      rgba(196, 145, 83, 0.14),
      transparent 36%
    );
    transform: translate3d(0, var(--grid-depth-y), 0);
    pointer-events: none;
  }

  .grid-archive__guide {
    position: sticky;
    top: 6.25rem;
    display: grid;
    grid-template-columns: 0.7rem minmax(0, 1fr);
    grid-template-rows: auto auto 11rem;
    align-self: start;
    gap: 0.45rem 0.6rem;
    min-width: 0;
    padding: 0.15rem 0;
    color: #bca17c;
    pointer-events: none;
  }

  .grid-archive__guide-kicker,
  .grid-archive__guide-count {
    grid-column: 1 / -1;
  }

  .grid-archive__guide-kicker {
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .grid-archive__guide-count {
    color: #ebd4b0;
    font-family: var(--font-family-display, Georgia, serif);
    font-size: clamp(0.68rem, 1vw, 0.78rem);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    letter-spacing: 0.045em;
    line-height: 1.25;
  }

  .grid-archive__guide-line {
    position: relative;
    grid-column: 1;
    grid-row: 3;
    display: block;
    width: 1px;
    height: 100%;
    margin-inline: auto;
    overflow: hidden;
    background: rgba(225, 196, 151, 0.22);
  }

  .grid-archive__guide-fill {
    position: absolute;
    inset: 0;
    display: block;
    background: linear-gradient(#c99f66, #f1d19c);
    box-shadow: 0 0 0.55rem rgba(226, 179, 105, 0.4);
    transform: scaleY(var(--grid-progress));
    transform-origin: top;
  }

  .grid-archive__feed {
    min-width: 0;
  }

  .dates-grid {
    --grid-item-gap: 0.75rem;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    grid-auto-flow: row;
    gap: var(--grid-item-gap);
    min-width: 0;
  }

  .grid-archive.is-grid-enhanced .dates-grid {
    grid-auto-rows: 4px;
    align-items: start;
  }

  .dates-grid > :global(.date-card),
  .dates-grid > :global(.grid-quote) {
    box-sizing: border-box;
    grid-column: auto / span 1;
    width: 100%;
    min-width: 0;
    align-self: start;
  }

  .dates-grid > :global([hidden]) {
    display: none !important;
  }

  .dates-grid > :global(.date-card) {
    --date-card-aspect-ratio: 5 / 6;
    --date-card-background: #eee3cd;
    --date-card-border: 1px solid rgba(97, 68, 43, 0.34);
    --date-card-radius: 0.32rem;
    --date-card-shadow:
      0 0.8rem 1.8rem rgba(5, 3, 2, 0.3), 0 0.16rem 0.35rem rgba(5, 3, 2, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.38);
    --date-card-media-background:
      radial-gradient(circle at 68% 24%, rgba(119, 78, 46, 0.12), transparent 42%),
      linear-gradient(142deg, rgba(255, 255, 255, 0.2), transparent 52%), #d8c3a2;
    --date-card-free-media-background:
      radial-gradient(circle at center, rgba(143, 91, 47, 0.19), transparent 62%), #dfcfb4;
    --date-card-info-background: #f1e6d2;
    --date-card-info-border: 1px solid rgba(91, 61, 38, 0.2);
    --date-card-info-padding: clamp(0.58rem, 1vw, 0.8rem);
    --date-card-title-color: #352218;
    --date-card-number-color: #6d4c32;
    --date-card-pending-background: #d8c29d;
    --date-card-pending-color: #4d321f;
    --date-card-completed-background: #c3c6a7;
    --date-card-completed-badge-color: #2d402f;
  }

  .dates-grid > :global(.date-card:nth-of-type(7n + 1)) {
    --date-card-aspect-ratio: 4 / 5;
  }

  .dates-grid > :global(.date-card:nth-of-type(7n + 2)) {
    --date-card-aspect-ratio: 1;
  }

  .dates-grid > :global(.date-card:nth-of-type(7n + 3)) {
    --date-card-aspect-ratio: 3 / 4;
  }

  .dates-grid > :global(.date-card:nth-of-type(7n + 5)) {
    --date-card-aspect-ratio: 6 / 7;
  }

  .dates-grid > :global(.date-card:nth-of-type(7n)) {
    --date-card-aspect-ratio: 7 / 8;
  }

  .dates-grid > :global(.grid-quote) {
    position: relative;
    display: grid;
    align-content: space-between;
    gap: 1.3rem;
    min-height: clamp(10rem, 18vw, 15rem);
    overflow: hidden;
    padding: clamp(1rem, 1.8vw, 1.45rem);
    color: #38251a;
    background:
      linear-gradient(rgba(91, 61, 38, 0.045) 1px, transparent 1px),
      radial-gradient(circle at 85% 12%, rgba(128, 83, 47, 0.12), transparent 35%), #eadbc0;
    background-size:
      100% 1.45rem,
      auto,
      auto;
    border: 1px solid rgba(89, 60, 38, 0.38);
    border-left: 0.32rem solid #9d7650;
    border-radius: 0.12rem 0.3rem 0.3rem 0.12rem;
    box-shadow:
      0 0.85rem 1.8rem rgba(5, 3, 2, 0.27),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
    transform: rotate(var(--grid-item-settled-rotation, 0deg));
  }

  .dates-grid > :global(.grid-quote)::before {
    content: '“';
    position: absolute;
    top: -0.4rem;
    right: 0.45rem;
    color: rgba(110, 72, 42, 0.16);
    font-family: var(--font-family-display, Georgia, serif);
    font-size: clamp(4rem, 7vw, 6rem);
    line-height: 1;
    pointer-events: none;
  }

  .dates-grid > :global(.grid-quote p) {
    position: relative;
    z-index: 1;
    margin: 0;
    font-family: var(--font-family-display, Georgia, serif);
    font-size: clamp(1rem, 1.55vw, 1.3rem);
    font-style: italic;
    font-weight: 700;
    line-height: 1.35;
    text-wrap: balance;
  }

  .dates-grid > :global(.grid-quote footer) {
    color: #72563d;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .grid-archive.is-grid-enhanced
    .dates-grid
    > :global(.is-grid-batch-revealed) {
    animation: grid-batch-reveal 560ms cubic-bezier(0.2, 0.72, 0.2, 1) both;
    animation-delay: var(--grid-wave-delay, 0ms);
  }

  .grid-archive.is-grid-enhanced
    .dates-grid
    > :global(.is-grid-item-measuring) {
    visibility: hidden;
  }

  @keyframes grid-batch-reveal {
    from {
      opacity: 0;
      translate: 0 1.4rem;
    }

    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  .grid-feed__status {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.25rem 0.35rem;
    text-align: center;
  }

  .grid-feed__status[hidden],
  .grid-feed__sentinel[hidden],
  .grid-feed__end[hidden] {
    display: none;
  }

  .grid-feed__count {
    margin: 0;
    color: #d9c19c;
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .grid-feed__sentinel {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.25rem;
    color: #b99d76;
    font-family: var(--font-family-display, Georgia, serif);
    font-size: 0.76rem;
    font-style: italic;
  }

  .grid-feed__loader {
    width: 0.48rem;
    aspect-ratio: 1;
    background: #d2aa70;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(210, 170, 112, 0.28);
    animation: grid-feed-breathe 1.4s ease-out infinite;
  }

  @keyframes grid-feed-breathe {
    70%,
    100% {
      box-shadow: 0 0 0 0.6rem rgba(210, 170, 112, 0);
    }
  }

  .grid-feed__end {
    max-width: 38rem;
    margin: 0.2rem 0 0;
    padding-top: 0.85rem;
    color: #e3cba7;
    border-top: 1px solid rgba(225, 196, 151, 0.24);
    font-family: var(--font-family-display, Georgia, serif);
    font-size: clamp(0.9rem, 1.4vw, 1.05rem);
    font-style: italic;
    line-height: 1.5;
    text-wrap: balance;
  }

  /* ===== El Álbum de Sobremesa ===== */
  .book-view {
    --album-gutter: clamp(1.75rem, 3.8vw, 2.65rem);
    --album-leaf-lift: 2.5rem;
    --album-mobile-gutter: clamp(1.65rem, 8vw, 2.35rem);
    --album-ring-lift: 4rem;
    width: 100%;
    min-width: 0;
    padding: 0;
    perspective: 2200px;
  }

  .album-story {
    position: relative;
    height: 210vh;
    height: 210svh;
    height: 210dvh;
    min-height: 100vh;
    min-height: 100svh;
    min-height: 100dvh;
  }

  .album-story__scene {
    --story-progress: 0;
    --story-light-x: 38%;
    --album-scale: 0.68;
    --album-shift-y: 10dvh;
    --album-depth: -8rem;
    --album-rotate-x: 17deg;
    --album-rotate-z: -2.2deg;
    --shadow-opacity: 0.92;
    --shadow-scale: 1.16;
    --shadow-blur: 25px;
    --paper-brightness: 1;
    --paper-sepia: 0;
    --controls-opacity: 0.68;
    --controls-y: 0.45rem;
    --folio-opacity: 0.58;
    --opening-opacity: 1;
    --opening-y: 0rem;
    --closing-opacity: 0;
    --closing-y: 3.2rem;
    --phrase-opacity: 1;
    --album-quote-opacity: 0;
    --album-quote-y: 0.35rem;
    --album-quote-fade-duration: 420ms;
    position: sticky;
    top: 0;
    display: grid;
    align-items: center;
    box-sizing: border-box;
    width: 100%;
    height: 100vh;
    height: 100svh;
    height: 100dvh;
    min-width: 0;
    overflow: clip;
    padding: max(1rem, env(safe-area-inset-top)) 4.8rem max(0.5rem, env(safe-area-inset-bottom))
      13.5rem;
    isolation: isolate;
  }

  .album-story__scene::before {
    content: '';
    position: absolute;
    z-index: 0;
    inset: 0;
    background:
      radial-gradient(
        circle at var(--story-light-x) 42%,
        rgba(216, 177, 122, 0.095),
        transparent 34%
      ),
      linear-gradient(180deg, rgba(255, 239, 208, 0.018), transparent 28% 76%, rgba(5, 3, 2, 0.18));
    pointer-events: none;
  }

  .album-story__scene::after {
    content: '';
    position: absolute;
    z-index: 0;
    inset: 12% 5% 10% 12%;
    opacity: 0.42;
    background: radial-gradient(ellipse at center, rgba(6, 3, 2, 0.32), transparent 68%);
    filter: blur(2.5rem);
    pointer-events: none;
  }

  .album-story__rail {
    position: absolute;
    z-index: 90;
    top: 50%;
    right: 0.55rem;
    display: grid;
    grid-template-columns: 0.75rem minmax(0, 1fr);
    grid-template-rows: auto 10.5rem auto;
    gap: 0.7rem 0.65rem;
    width: 3.65rem;
    color: #e4cda8;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .album-story__rail-count {
    grid-column: 1 / -1;
    display: flex;
    align-items: baseline;
    gap: 0.26rem;
    color: #f2dec0;
    font-family: var(--font-family-display, Georgia, serif);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }

  .album-story__rail-count span:last-child {
    color: #9f8768;
    font-size: 0.52rem;
  }

  .album-story__rail-line {
    position: relative;
    grid-column: 1;
    grid-row: 2;
    width: 1px;
    height: 100%;
    margin-inline: auto;
    overflow: hidden;
    background: rgba(224, 194, 151, 0.24);
  }

  .album-story__rail-fill {
    position: absolute;
    inset: 0;
    display: block;
    background: linear-gradient(#e0bb7c, #f5dfb9);
    box-shadow: 0 0 0.65rem rgba(226, 179, 105, 0.45);
    transform: scaleY(var(--story-progress));
    transform-origin: top;
  }

  .album-story__rail-acts {
    grid-column: 2;
    grid-row: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: #8f785d;
    font-variant-numeric: tabular-nums;
  }

  .album-story__rail-acts span {
    position: relative;
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .album-story__rail-acts span::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -0.68rem;
    width: 0.35rem;
    height: 1px;
    opacity: 0;
    background: currentColor;
    transform: translateY(-50%);
  }

  .album-story__rail-acts span.is-active {
    color: #f4dfbd;
    transform: translateX(0.14rem);
  }

  .album-story__rail-acts span.is-active::before {
    opacity: 1;
  }

  .album-story__rail p {
    grid-column: 1 / -1;
    width: 8.5rem;
    margin: 0;
    color: #d5bd98;
    font-family: var(--font-family-display, Georgia, serif);
    font-size: 0.68rem;
    font-style: italic;
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: 1.25;
    text-transform: none;
    transform: translateX(calc(-100% + 3.65rem));
  }

  .album-story__final-note {
    position: absolute;
    z-index: 2;
    top: max(4.65rem, calc(env(safe-area-inset-top) + 4.25rem));
    left: max(1rem, calc(env(safe-area-inset-left) + 0.75rem));
    width: min(20rem, calc(100% - 7.5rem));
    margin: 0;
    color: #f3e8d6;
    font-family: var(--font-family-display, Georgia, serif);
    font-size: clamp(0.98rem, 1.65vw, 1.35rem);
    font-style: normal;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.15;
    text-wrap: balance;
    visibility: hidden;
    opacity: var(--album-quote-opacity);
    transform: translate3d(0, var(--album-quote-y), 0);
    transform-origin: top left;
    transition:
      opacity var(--album-quote-fade-duration) ease,
      transform var(--album-quote-fade-duration) ease;
    pointer-events: none;
    will-change: opacity, transform;
  }

  .album-story__final-note.is-quote-active {
    visibility: visible;
  }

  .album-story__final-note::after {
    content: '';
    display: inline-block;
    width: 0.075em;
    height: 0.94em;
    margin-left: 0.18em;
    vertical-align: -0.08em;
    opacity: 0;
    background: currentColor;
  }

  .album-story__final-note.is-quote-active::after {
    opacity: 0.72;
    animation: album-quote-cursor 1.05s steps(1, end) infinite;
  }

  .album-story__final-note.is-quote-fading::after {
    opacity: 0;
    animation: none;
  }

  @keyframes album-quote-cursor {
    0%,
    48% {
      opacity: 0.72;
    }

    49%,
    100% {
      opacity: 0.08;
    }
  }

  .album-story__phrases {
    position: absolute;
    z-index: 0;
    inset: 0;
    opacity: var(--phrase-opacity);
    pointer-events: none;
  }

  .album-story__phrase {
    position: absolute;
    max-width: 19rem;
    margin: 0;
    color: rgba(232, 211, 177, 0.72);
    font-family: var(--font-family-display, Georgia, serif);
    font-size: clamp(0.72rem, 1.15vw, 0.96rem);
    font-style: italic;
    letter-spacing: 0.012em;
    line-height: 1.35;
    text-wrap: balance;
    transform: translate3d(var(--phrase-x, 0), var(--phrase-y, 0), 0);
  }

  .album-story__phrase::before {
    content: '—';
    margin-right: 0.38rem;
    color: rgba(194, 158, 105, 0.62);
  }

  .album-story__phrase--one {
    top: 7.5%;
    left: 46%;
  }

  .album-story__phrase--two {
    top: 22%;
    right: 5.5rem;
    max-width: 13rem;
    text-align: right;
  }

  .album-story__phrase--three {
    bottom: 6%;
    left: 14.5rem;
    max-width: 18rem;
  }

  .album-story__phrase--four {
    right: 5.5rem;
    bottom: 25%;
    max-width: 13rem;
    text-align: right;
  }

  .album-story__annotation {
    position: absolute;
    z-index: 0;
    max-width: 16rem;
    margin: 0;
    color: rgba(226, 205, 172, 0.8);
    font-family: var(--font-family-display, Georgia, serif);
    font-size: clamp(0.7rem, 1vw, 0.84rem);
    font-style: italic;
    letter-spacing: 0.02em;
    line-height: 1.4;
    pointer-events: none;
  }

  .album-story__annotation span {
    display: block;
    margin-bottom: 0.2rem;
    color: #a98e69;
    font-family: inherit;
    font-size: 0.52rem;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .album-story__annotation--opening {
    top: 8%;
    left: 14.5rem;
    opacity: var(--opening-opacity);
    transform: translate3d(0, var(--opening-y), 0);
  }

  .album-story__annotation--closing {
    right: 5.25rem;
    bottom: 7%;
    opacity: var(--closing-opacity);
    text-align: right;
    transform: translate3d(0, var(--closing-y), 0);
  }

  .book-view[data-story-enabled='false'] .album-story {
    height: auto;
    min-height: 0;
  }

  .book-view[data-story-enabled='false'] .album-story__scene {
    position: relative;
    height: auto;
    min-height: 0;
    overflow: visible;
    padding: clamp(0.5rem, 2vw, 1.25rem) 0 2rem;
  }

  .book-view[data-story-enabled='false'] .album-story__rail,
