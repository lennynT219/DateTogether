    #album-motion-host :global(.album-turn--prev.is-turning) {
      animation-name: album-mobile-turn-prev;
    }

    @keyframes album-mobile-turn-prev {
      0% {
        transform: rotateY(-180deg) translateZ(0);
      }
      42% {
        transform: rotateY(-110deg) translateZ(0.7rem);
      }
      72% {
        transform: rotateY(-42deg) translateZ(0.35rem);
      }
      100% {
