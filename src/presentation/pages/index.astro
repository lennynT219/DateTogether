      }
    }

    #album-motion-host :global(.album-turn-shadow--next),
    #album-motion-host :global(.album-turn-shadow--prev) {
      right: 0;
      left: var(--album-mobile-gutter);
      background: linear-gradient(
        90deg,
        rgba(38, 20, 11, 0.42),
        rgba(38, 20, 11, 0.16) 46%,
        transparent 94%
      );
      transform-origin: left center;
    }
  }

