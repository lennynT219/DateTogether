---
import BaseLayout from '../layouts/BaseLayout.astro';
import TimeCounter from '../components/TimeCounter.astro';
import ProgressBar from '../components/ProgressBar.astro';
import DateCard from '../components/DateCard.astro';
import { SupabaseDateRepository } from '../../infrastructure/repositories/SupabaseDateRepository';
import { GetDashboardData } from '../../core/use-cases/GetDashboardData';

export const prerender = false;

const togetherSince = import.meta.env.TOGETHER_SINCE || '2024-01-01T00:00:00Z';

const dateRepo = new SupabaseDateRepository();
const getDashboardData = new GetDashboardData(dateRepo);
const { status, dates, progress } = await getDashboardData.execute();

// Book: 4 cards per page, 8 visible on desktop spread (4 left + 4 right)
const perPage = 4;
const totalPages = Math.ceil(dates.length / perPage);
const gridQuoteAnchorPositions = [8, 16, 24, 32, 40, 48, 56, 64, 72, 80, 88, 96];
const gridQuotePhrases = [
  'Todo lo bueno empezó cuando nos encontramos.',
  'Haces que un día cualquiera sea mi favorito.',
  'La rutina no pesa cuando estoy contigo.',
  'Me quedaría a vivir en tu sonrisa.',
  'Cada ratito contigo me lo guardo en el pecho.',
  'Qué bonito es hacer historia a tu lado.',
  'Cualquier plan es perfecto si vienes conmigo.',
  'Mi mejor plan siempre vas a ser tú.',
  'Hay momentos contigo que ojalá duraran toda la vida.',
  'Le pones luz a todo, hasta a los días más grises.',
  'Un abrazo tuyo es todo el refugio que necesito.',
  'Contigo me siento en casa, no importa dónde estemos.',
];
---

<BaseLayout title="DatesTogether | Álbum de las 100 citas">
  <div class="dashboard">
    <div class="dashboard__shell">
      <header class="dashboard__header">
        <div class="dashboard__masthead">
          <div class="dashboard__intro">
            <p class="dashboard__eyebrow">El reto de nuestras 100 citas</p>
            <h1>Nuestro álbum de citas</h1>
            <p class="dashboard__supporting">
              Cien planes para volver a elegirnos, una página y un recuerdo a la vez.
            </p>
          </div>
          <button class="dashboard__logout" id="logout-btn" type="button">Cerrar sesión</button>
        </div>
      </header>
      {
        status === 'ready' && (
          <>
            <div class="dashboard__summary-slot" data-summary-slot>
              <section class="dashboard__summary" data-summary-hud aria-labelledby="summary-title">
                <p class="dashboard__hud-title" data-hud-title hidden></p>
                <div class="dashboard__summary-counter">
                  <p class="dashboard__summary-kicker">Tiempo compartido</p>
                  <h2 id="summary-title">Lo que llevamos juntos</h2>
                  <TimeCounter togetherSince={togetherSince} />
                </div>
                <div class="dashboard__summary-progress">
                  <ProgressBar completed={progress.completed} total={progress.total} />
                </div>
              </section>
            </div>
          </>
        )
      }
      <main class="dashboard__main" id="main-content">
        {
          status === 'unavailable' ? (
            <section class="dashboard__notice" aria-labelledby="unavailable-title">
              <p class="dashboard__notice-kicker">El álbum está en pausa</p>
              <h2 id="unavailable-title">No pudimos cargar las citas</h2>
              <p>
                Los recuerdos siguen a salvo. Intenta abrir el álbum nuevamente dentro de unos
                minutos.
              </p>
            </section>
          ) : dates.length === 0 ? (
            <section class="dashboard__notice" aria-labelledby="empty-title">
              <p class="dashboard__notice-kicker">Una historia por comenzar</p>
              <h2 id="empty-title">El álbum todavía no tiene citas</h2>
              <p>
                Cuando haya citas disponibles, aparecerán aquí listas para crear nuevos recuerdos.
              </p>
            </section>
          ) : (
            <section class="dashboard__collection" aria-labelledby="collection-title">
              <div class="dashboard__toolbar">
                <div>
                  <p class="dashboard__section-kicker">Colección principal</p>
                  <h2 id="collection-title">Las páginas de nuestra historia</h2>
                </div>
                <div class="dashboard__view-toggle" role="group" aria-label="Vista de la colección">
                  <button
                    class="view-btn view-btn--active"
                    type="button"
                    data-view="grid"
                    aria-pressed="true"
                    aria-controls="grid-view"
                  >
                    Cuadrícula
                  </button>
                  <button
                    class="view-btn"
                    type="button"
                    data-view="book"
                    aria-pressed="false"
                    aria-controls="book-view"
                  >
                    Álbum
                  </button>
                </div>
              </div>

              <div class="grid-archive" data-grid-archive>
                <aside class="grid-archive__guide" aria-hidden="true">
                  <span class="grid-archive__guide-kicker">Colección fotográfica</span>
                  <span class="grid-archive__guide-count">
                    Archivo 001—{String(dates.length).padStart(3, '0')}
                  </span>
                  <span class="grid-archive__guide-line">
                    <span class="grid-archive__guide-fill" />
                  </span>
                </aside>
                <div class="grid-archive__feed">
                  <div class="dates-grid" id="grid-view" aria-hidden="false">
                    {dates.map((date, index) => {
                      const afterCard = index + 1;
                      const phraseIndex = gridQuoteAnchorPositions.indexOf(afterCard);

                      return (
                        <>
                          <DateCard date={date} />
                          {
                            phraseIndex >= 0 && (
                              <blockquote
                                class="grid-quote"
                                data-after-card={afterCard}
                                style={`--grid-item-settled-rotation: ${[-0.55, 0.42, -0.32, 0.5, -0.4, 0.3, -0.48, 0.36, -0.28, 0.46, -0.34, 0.38][phraseIndex]}deg`}
                              >
                                <p>{gridQuotePhrases[phraseIndex]}</p>
                                <footer>Nota del archivo</footer>
                              </blockquote>
                            )
                          }
                        </>
                      );
                    })}
                  </div>
                  <div class="grid-feed__status" data-grid-feed-status hidden>
                    <p
                      class="grid-feed__count"
                      data-grid-feed-count
                      role="status"
                      aria-live="polite"
                      aria-atomic="true"
                    />
                    <div class="grid-feed__sentinel" data-grid-feed-sentinel aria-hidden="true">
                      <span class="grid-feed__loader" />
                      <span>Abriendo más recuerdos…</span>
                    </div>
                    <p class="grid-feed__end" data-grid-feed-end hidden>
                      Aquí termina el archivo por ahora. Lo nuestro todavía sigue sumando páginas.
                    </p>
                  </div>
                </div>
              </div>

              <div
                class="book-view"
                id="book-view"
                data-total-pages={totalPages}
                data-per-page={perPage}
                aria-hidden="true"
                aria-busy="false"
                style="display: none;"
              >
                <div class="album-story" id="album-story">
                  <div class="album-story__scene" id="album-story-scene">
                    <aside class="album-story__rail" aria-hidden="true">
                      <div class="album-story__rail-count">
                        <span data-story-act-number>01</span>
                        <span>/ 03</span>
                      </div>
                      <div class="album-story__rail-line">
                        <span class="album-story__rail-fill" />
                      </div>
                      <div class="album-story__rail-acts">
                        <span class="is-active" data-story-act="1">01</span>
                        <span data-story-act="2">02</span>
                        <span data-story-act="3">03</span>
                      </div>
                      <p data-story-act-label>La historia comienza</p>
                    </aside>

                    <p class="album-story__final-note" aria-hidden="true" data-album-quote>
                      <span data-album-quote-text></span>
                    </p>

                    <div class="album-story__phrases" aria-hidden="true">
                      <p class="album-story__phrase album-story__phrase--one" data-story-phrase>
                        Todo empezó con un sí.
                      </p>
                      <p class="album-story__phrase album-story__phrase--two" data-story-phrase>
                        Cien planes, una historia.
                      </p>
                      <p class="album-story__phrase album-story__phrase--three" data-story-phrase>
                        Lo cotidiano también merece memoria.
                      </p>
                      <p class="album-story__phrase album-story__phrase--four" data-story-phrase>
                        Volver a elegirnos.
                      </p>
                    </div>

                    <p class="album-story__annotation album-story__annotation--opening" aria-hidden="true">
                      <span>Archivo de lo cotidiano</span>
                      Cien planes, una historia
                    </p>
                    <p class="album-story__annotation album-story__annotation--closing" aria-hidden="true">
                      <span>Capítulo abierto</span>
                      Lo mejor todavía se está escribiendo
                    </p>

                    <div class="album-stage" id="album-stage">
                      <div class="album-stage__cast-shadow" aria-hidden="true" />
                      <div class="album-object" id="album-object">
                    <div class="album-cover__board" aria-hidden="true" />
                    <div class="album-cover__stitching" aria-hidden="true" />
                    <div class="album-cover__corners" aria-hidden="true">
                      {Array.from({ length: 4 }, (_, index) => (
                        <span class={`album-cover__corner album-cover__corner--${index + 1}`} />
                      ))}
                    </div>
                    <div class="album-cover__plaque" aria-hidden="true">
                      Vol. I
                    </div>
                    <div class="album-paper-block" aria-hidden="true">
                      <span class="album-paper-block__outside album-paper-block__outside--left" />
                      <span class="album-paper-block__outside album-paper-block__outside--right" />
                      <span class="album-paper-block__bottom" />
                    </div>

                    <div class="album-spread" id="album-spread">
                      <div class="album-page-stack album-page-stack--left" aria-hidden="true" />
                      <div class="album-page-stack album-page-stack--right" aria-hidden="true" />

                      <section
                        class="album-leaf album-leaf--left"
                        id="album-leaf-left"
                        aria-label={`Hoja 1 de ${totalPages}, citas 1 a ${Math.min(perPage, dates.length)}`}
                      >
                        <div class="album-leaf__holes" aria-hidden="true">
                          {Array.from({ length: 9 }, () => (
                            <span />
                          ))}
                        </div>
                        <div class="album-leaf__content" />
                      </section>

                      <div class="album-trough" aria-hidden="true" />

                      <section
                        class="album-leaf album-leaf--right"
                        id="album-leaf-right"
                        aria-label={`Hoja ${Math.min(2, totalPages)} de ${totalPages}`}
                      >
                        <div class="album-leaf__holes" aria-hidden="true">
                          {Array.from({ length: 9 }, () => (
                            <span />
                          ))}
                        </div>
                        <div class="album-leaf__content" />
                      </section>

                      <div id="album-motion-host" aria-hidden="true" inert />

                      <div class="album-rings" aria-hidden="true">
                        {Array.from({ length: 9 }, () => (
                          <span class="album-ring" />
                        ))}
                      </div>
                    </div>

                        <nav class="album-controls" aria-label="Paginación del álbum">
                          <button class="album-controls__button" id="book-prev" type="button">
                            <span aria-hidden="true">←</span>
                            Anterior
                          </button>
                          <span class="album-controls__indicator" id="book-indicator">
                            Hoja 01 de {totalPages} · Citas 01–
                            {String(Math.min(perPage, dates.length)).padStart(2, '0')}
                          </span>
                          <button class="album-controls__button" id="book-next" type="button">
                            Siguiente
                            <span aria-hidden="true">→</span>
                          </button>
                        </nav>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <p
                class="visually-hidden"
                id="book-live-status"
                role="status"
                aria-live="polite"
                aria-atomic="true"
              />
            </section>
          )
        }
      </main>
    </div>
  </div>
</BaseLayout>

<script>
  // --- Album Story, Grid Archive, Contextual Summary, and Physical Leaf Navigation ---
  const summaryHud = document.querySelector<HTMLElement>('[data-summary-hud]');
  const summarySlot = document.querySelector<HTMLElement>('[data-summary-slot]');
  const hudTitle = document.querySelector<HTMLElement>('[data-hud-title]');
  const gridBtn = document.querySelector<HTMLButtonElement>('[data-view="grid"]');
  const bookBtn = document.querySelector<HTMLButtonElement>('[data-view="book"]');
  const gridView = document.getElementById('grid-view');
  const gridArchive = document.querySelector<HTMLElement>('[data-grid-archive]');
  const gridFeedStatus = document.querySelector<HTMLElement>('[data-grid-feed-status]');
  const gridFeedCount = document.querySelector<HTMLElement>('[data-grid-feed-count]');
  const gridFeedSentinel = document.querySelector<HTMLElement>('[data-grid-feed-sentinel]');
  const gridFeedEnd = document.querySelector<HTMLElement>('[data-grid-feed-end]');
  const bookView = document.getElementById('book-view');
  const albumStory = document.getElementById('album-story');
  const albumScene = document.getElementById('album-story-scene');
  const albumStage = document.getElementById('album-stage');
  const leftLeaf = document.getElementById('album-leaf-left');
  const rightLeaf = document.getElementById('album-leaf-right');
  const motionHost = document.getElementById('album-motion-host');
  const indicator = document.getElementById('book-indicator');
  const liveStatus = document.getElementById('book-live-status');
  const prevBtn = document.getElementById('book-prev') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('book-next') as HTMLButtonElement | null;

  const perPage = Number.parseInt(bookView?.dataset.perPage ?? '4', 10);
  const totalBookPages = Number.parseInt(bookView?.dataset.totalPages ?? '0', 10);
  const lastBookPage = Math.max(totalBookPages - 1, 0);
  const TURN_DURATION_MS = 620;
  const GRID_INITIAL_BATCH_SIZE = 24;
  const GRID_BATCH_SIZE = 16;
  const GRID_LOAD_AHEAD_PX = 320;
  const GRID_MASONRY_ROW_PX = 4;
  const ALBUM_PRESENTATION_LIMIT = 0.75;
  const ALBUM_VISUAL_ACT_TWO_START = 0.28;
  const ALBUM_VISUAL_ACT_THREE_START = 0.7;
  const ALBUM_RAIL_ACT_TWO_START =
    ALBUM_VISUAL_ACT_TWO_START / ALBUM_PRESENTATION_LIMIT;
  const ALBUM_RAIL_ACT_THREE_START =
    ALBUM_VISUAL_ACT_THREE_START / ALBUM_PRESENTATION_LIMIT;
  const ALBUM_QUOTE_CYCLE_CONFIG = {
    typeSpeedMs: 42,
    holdDurationMs: 2200,
    fadeDurationMs: 420,
    activationProgress: ALBUM_RAIL_ACT_TWO_START,
  };
  const ALBUM_QUOTE_PHRASES = [
    'Todo lo bueno empezó cuando nos encontramos.',
    'Haces que un día cualquiera sea mi favorito.',
    'La rutina no pesa cuando estoy contigo.',
    'Me quedaría a vivir en tu sonrisa.',
    'Cada ratito contigo me lo guardo en el pecho.',
    'Qué bonito es hacer historia a tu lado.',
    'Cualquier plan es perfecto si vienes conmigo.',
    'Mi mejor plan siempre vas a ser tú.',
    'Hay momentos contigo que ojalá duraran toda la vida.',
    'Le pones luz a todo, hasta a los días más grises.',
    'Un abrazo tuyo es todo el refugio que necesito.',
    'Contigo me siento en casa, no importa dónde estemos.',
  ];
  const mobileQuery = window.matchMedia('(max-width: 768px)');
  const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const storyActLabel = albumScene?.querySelector<HTMLElement>('[data-story-act-label]');
  const storyActNumber = albumScene?.querySelector<HTMLElement>('[data-story-act-number]');
  const albumQuote = albumScene?.querySelector<HTMLElement>('[data-album-quote]');
  const albumQuoteText = albumQuote?.querySelector<HTMLElement>('[data-album-quote-text]');
  const storyActMarkers = Array.from(
    albumScene?.querySelectorAll<HTMLElement>('[data-story-act]') ?? [],
  );
  const storyPhrases = Array.from(
    albumScene?.querySelectorAll<HTMLElement>('[data-story-phrase]') ?? [],
  );

  const gridCards = Array.from(gridView?.querySelectorAll<HTMLElement>('.date-card') ?? []);
  const initialGridQuotePhrases = Array.from(
    gridView?.querySelectorAll<HTMLElement>('.grid-quote p') ?? [],
    (element) => element.textContent?.trim() ?? '',
  ).filter(Boolean);
  const albumCards = gridCards.map(
    (card) => ({
      html: card.outerHTML,
      completed: card.dataset.completed === 'true',
    }),
  );

  interface GridQuoteTile {
    element: HTMLElement;
    afterCard: number;
  }

  let currentPage = 0;
  let isAnimating = false;
  let motionToken = 0;
  let storyFrame = 0;
  let gridFrame = 0;
  let gridBatchFrame = 0;
  let gridSentinelSyncFrame = 0;
  let gridMasonryFrame = 0;
  let gridMasonryScrollRestoreUntil = 0;
  let gridBatchObserver: IntersectionObserver | null = null;
  let gridResizeObserver: ResizeObserver | null = null;
  let gridSentinelArmed = false;
  let gridFallbackListening = false;
  let gridResizeObserverConnected = false;
  let gridMeasuredWidth = 0;
  let gridFeedInitialized = false;
  let revealedGridCardCount = 0;
  let gridQuoteTiles: GridQuoteTile[] = [];
  const pendingGridRevealElements = new Set<HTMLElement>();
  let resizeTimer: number | undefined;
  let albumQuoteTypeTimer: number | undefined;
  let albumQuoteHoldTimer: number | undefined;
  let albumQuoteFadeTimer: number | undefined;
  let albumQuoteActive = false;
  let albumQuoteOrder: string[] = [];
  let previousAlbumQuoteOrder: string[] | null = null;
  let lastDisplayedAlbumQuote: string | null = null;
  let albumQuoteIndex = 0;

  interface ActiveTurn {
    token: number;
    finish: () => void;
  }

  let activeTurn: ActiveTurn | null = null;

  const padNumber = (value: number) => String(value).padStart(2, '0');
  const clamp = (value: number, minimum: number, maximum: number) =>
    Math.min(Math.max(value, minimum), maximum);
  const lerp = (start: number, end: number, progress: number) =>
    start + (end - start) * progress;
  const clampPage = (pageIndex: number) =>
    Math.min(Math.max(pageIndex, 0), lastBookPage);

  function disableNativeAlbumDrags() {
    for (const element of albumStage?.querySelectorAll('img, svg') ?? []) {
      element.setAttribute('draggable', 'false');
    }
  }

  function clearAlbumQuoteTimers() {
    if (albumQuoteTypeTimer !== undefined) window.clearTimeout(albumQuoteTypeTimer);
    if (albumQuoteHoldTimer !== undefined) window.clearTimeout(albumQuoteHoldTimer);
    if (albumQuoteFadeTimer !== undefined) window.clearTimeout(albumQuoteFadeTimer);
    albumQuoteTypeTimer = undefined;
    albumQuoteHoldTimer = undefined;
    albumQuoteFadeTimer = undefined;
  }

  function hasMatchingQuoteOrder(first: string[], second: string[] | null) {
    return Boolean(second) && first.every((phrase, index) => phrase === second[index]);
  }

  function createRandomAlbumQuoteOrder() {
    let nextOrder = [...ALBUM_QUOTE_PHRASES];

    do {
      for (let index = nextOrder.length - 1; index > 0; index -= 1) {
        const randomIndex = Math.floor(Math.random() * (index + 1));
        [nextOrder[index], nextOrder[randomIndex]] = [nextOrder[randomIndex], nextOrder[index]];
      }
    } while (
      nextOrder[0] === lastDisplayedAlbumQuote ||
      hasMatchingQuoteOrder(nextOrder, previousAlbumQuoteOrder)
    );

    return nextOrder;
  }

  function resetAlbumQuoteCycle() {
    clearAlbumQuoteTimers();
    if (albumQuoteOrder.length) previousAlbumQuoteOrder = [...albumQuoteOrder];
    albumQuoteActive = false;
    albumQuoteOrder = [];
    albumQuoteIndex = 0;
    if (albumQuoteText) albumQuoteText.textContent = '';
    albumQuote?.classList.remove('is-quote-active', 'is-quote-typing', 'is-quote-fading');
    albumQuote?.style.removeProperty('--album-quote-opacity');
    albumQuote?.style.removeProperty('--album-quote-y');
    albumQuote?.style.removeProperty('--album-quote-fade-duration');
  }

  function fadeAlbumQuote() {
    if (!albumQuoteActive || !albumQuote) return;
    albumQuoteHoldTimer = undefined;
    albumQuote.classList.remove('is-quote-typing');
    albumQuote.classList.add('is-quote-fading');
    albumQuote.style.setProperty('--album-quote-opacity', '0');
    albumQuote.style.setProperty('--album-quote-y', '-0.15rem');
    albumQuoteFadeTimer = window.setTimeout(() => {
      albumQuoteFadeTimer = undefined;
      if (!albumQuoteActive) return;
      if (albumQuoteText) albumQuoteText.textContent = '';
      albumQuote.classList.remove('is-quote-active', 'is-quote-fading');
      albumQuoteIndex += 1;
      showNextAlbumQuote();
    }, ALBUM_QUOTE_CYCLE_CONFIG.fadeDurationMs);
  }

  function showNextAlbumQuote() {
    if (!albumQuoteActive || !albumQuote || !albumQuoteText) return;
    if (albumQuoteIndex >= albumQuoteOrder.length) {
      previousAlbumQuoteOrder = [...albumQuoteOrder];
      albumQuoteOrder = createRandomAlbumQuoteOrder();
      albumQuoteIndex = 0;
    }

    const phrase = albumQuoteOrder[albumQuoteIndex];
    if (!phrase) return;
    let characterIndex = 0;
    albumQuoteText.textContent = '';
    albumQuote.classList.remove('is-quote-fading');
    albumQuote.classList.add('is-quote-active', 'is-quote-typing');
    albumQuote.style.setProperty('--album-quote-opacity', '1');
    albumQuote.style.setProperty('--album-quote-y', '0rem');
    albumQuote.style.setProperty(
      '--album-quote-fade-duration',
      `${ALBUM_QUOTE_CYCLE_CONFIG.fadeDurationMs}ms`,
    );

    const typeNextCharacter = () => {
      if (!albumQuoteActive || !albumQuoteText) return;
      albumQuoteText.textContent = phrase.slice(0, characterIndex + 1);
      characterIndex += 1;

      if (characterIndex >= phrase.length) {
        albumQuoteTypeTimer = undefined;
        lastDisplayedAlbumQuote = phrase;
        albumQuote.classList.remove('is-quote-typing');
        albumQuoteHoldTimer = window.setTimeout(
          fadeAlbumQuote,
          ALBUM_QUOTE_CYCLE_CONFIG.holdDurationMs,
        );
        return;
      }

      albumQuoteTypeTimer = window.setTimeout(
        typeNextCharacter,
        ALBUM_QUOTE_CYCLE_CONFIG.typeSpeedMs,
      );
    };

    typeNextCharacter();
  }

  function startAlbumQuoteCycle() {
    if (!albumQuote || !albumQuoteText) return;
    resetAlbumQuoteCycle();
    albumQuoteActive = true;
    albumQuoteOrder = createRandomAlbumQuoteOrder();
    showNextAlbumQuote();
  }

  function updateAlbumQuoteCycle(rawStoryProgress: number) {
    const shouldBeActive =
      isBookActive() &&
      !reducedMotionQuery.matches &&
      rawStoryProgress >= ALBUM_QUOTE_CYCLE_CONFIG.activationProgress;
    if (!shouldBeActive) {
      resetAlbumQuoteCycle();
      return;
    }
    if (!albumQuoteActive) startAlbumQuoteCycle();
  }

  function getLeafCards(pageIndex: number) {
    if (pageIndex < 0 || pageIndex >= totalBookPages) return [];
    const start = pageIndex * perPage;
    return albumCards.slice(start, start + perPage);
  }

  function getLeafRange(pageIndex: number) {
    const cards = getLeafCards(pageIndex);
    const start = pageIndex * perPage + 1;
    return {
      start,
      end: start + Math.max(cards.length - 1, 0),
      count: cards.length,
    };
  }

  function getLeafLabel(pageIndex: number) {
    const range = getLeafRange(pageIndex);
    return `Hoja ${pageIndex + 1} de ${totalBookPages}, citas ${range.start} a ${range.end}`;
  }

  function getLeafContent(pageIndex: number) {
    const cards = getLeafCards(pageIndex);
    const completed = cards.filter((card) => card.completed).length;
    const dateLabel = cards.length === 1 ? '1 cita' : `${cards.length} citas`;
    const completedLabel = completed === 1 ? '1 completada' : `${completed} completadas`;

    return `
      <header class="album-leaf__header">
        <span>Nuestras citas · Vol. I</span>
        <span>Archivo personal</span>
      </header>
      <div class="album-leaf__cards">${cards.map((card) => card.html).join('')}</div>
      <footer class="album-leaf__footer">
        <span class="album-leaf__annotation">${dateLabel} · ${completedLabel}</span>
        <span class="album-leaf__folio" aria-hidden="true">${padNumber(pageIndex + 1)}</span>
      </footer>
    `;
  }

  function getEndpaperContent() {
    return `
      <header class="album-leaf__header">
        <span>Nuestras citas · Vol. I</span>
        <span>Archivo personal</span>
      </header>
      <div class="album-endpaper">
        <span class="album-endpaper__ornament" aria-hidden="true">✦</span>
        <p>Fin de este capítulo</p>
        <span>La historia continúa</span>
      </div>
      <footer class="album-leaf__footer album-leaf__footer--endpaper">
        <span class="album-leaf__annotation">Colección en curso</span>
      </footer>
    `;
  }

  function renderLeaf(element: HTMLElement, pageIndex: number) {
    const content = element.querySelector<HTMLElement>('.album-leaf__content');
    if (!content) return;

    if (pageIndex < 0 || pageIndex >= totalBookPages) {
      element.classList.add('is-endpaper');
      element.removeAttribute('data-leaf-index');
      element.setAttribute('aria-label', 'Fin de este capítulo');
      content.innerHTML = getEndpaperContent();
      return;
    }

    element.classList.remove('is-endpaper');
    element.dataset.leafIndex = String(pageIndex);
    element.setAttribute('aria-label', getLeafLabel(pageIndex));
    content.innerHTML = getLeafContent(pageIndex);
  }

  function renderStaticSpread(pageIndex: number) {
    if (!leftLeaf || !rightLeaf) return;
    const safeIndex = clampPage(pageIndex);
    renderLeaf(leftLeaf, safeIndex);

    if (mobileQuery.matches) {
      rightLeaf.setAttribute('aria-hidden', 'true');
      renderLeaf(rightLeaf, safeIndex + 1);
    } else {
      rightLeaf.removeAttribute('aria-hidden');
      renderLeaf(rightLeaf, safeIndex + 1);
    }
    disableNativeAlbumDrags();
  }

  function getStatus(pageIndex: number) {
    const safeIndex = clampPage(pageIndex);
    const visiblePages = [safeIndex];
    if (!mobileQuery.matches && safeIndex + 1 < totalBookPages) visiblePages.push(safeIndex + 1);

    const firstPage = visiblePages[0] ?? 0;
    const lastPage = visiblePages[visiblePages.length - 1] ?? firstPage;
    const firstRange = getLeafRange(firstPage);
    const lastRange = getLeafRange(lastPage);
    const pageText =
      visiblePages.length === 1
        ? `Hoja ${padNumber(firstPage + 1)}`
        : `Hojas ${padNumber(firstPage + 1)}–${padNumber(lastPage + 1)}`;

    return `${pageText} de ${totalBookPages} · Citas ${padNumber(firstRange.start)}–${padNumber(lastRange.end)}`;
  }

  function updateStatus(pageIndex: number, announce = false) {
    const statusText = getStatus(pageIndex);
    if (indicator) indicator.textContent = statusText;
    if (announce && liveStatus) liveStatus.textContent = statusText;
  }

  function updateControls() {
    const isAtStart = currentPage <= 0;
    const isAtEnd = currentPage >= lastBookPage;
    if (prevBtn) {
      prevBtn.disabled = isAtStart;
      prevBtn.setAttribute('aria-disabled', String(isAnimating || isAtStart));
    }
    if (nextBtn) {
      nextBtn.disabled = isAtEnd;
      nextBtn.setAttribute('aria-disabled', String(isAnimating || isAtEnd));
    }
  }

  function commitPage(pageIndex: number, announce = false) {
    currentPage = clampPage(pageIndex);
    renderStaticSpread(currentPage);
    updateStatus(currentPage, announce);
    updateControls();
  }

  function setBookBusy(busy: boolean) {
    bookView?.setAttribute('aria-busy', String(busy));
  }

  function prepareReveal(targetIndex: number, direction: 'next' | 'prev') {
    if (!leftLeaf || !rightLeaf) return;

    if (mobileQuery.matches) {
      if (direction === 'next') renderLeaf(leftLeaf, targetIndex);
      return;
    }

    if (direction === 'next') renderLeaf(rightLeaf, targetIndex + 1);
    else renderLeaf(leftLeaf, targetIndex);
  }

  function createTurningLeaf(pageIndex: number, direction: 'next' | 'prev') {
    if (!motionHost) return null;
    const content = getLeafContent(pageIndex);
    const holes = `<div class="album-turn__holes">${Array.from({ length: 9 }, () => '<span></span>').join('')}</div>`;
    motionHost.dataset.direction = direction;
    motionHost.innerHTML = `
      <div class="album-turn album-turn--${direction}" aria-hidden="true" inert>
        <div class="album-turn__face album-turn__face--front">${holes}${content}</div>
        <div class="album-turn__face album-turn__face--back">${holes}${content}</div>
      </div>
      <div class="album-turn-shadow album-turn-shadow--${direction}" aria-hidden="true" inert></div>
    `;
    disableNativeAlbumDrags();
    return motionHost.querySelector<HTMLElement>('.album-turn');
  }

  function navigateTo(targetIndex: number, direction: 'next' | 'prev') {
    if (isAnimating || targetIndex < 0 || targetIndex >= totalBookPages) return;

    if (reducedMotionQuery.matches) {
      commitPage(targetIndex, true);
      return;
    }

    const sourceIndex = currentPage;
    const turningPage = mobileQuery.matches
      ? direction === 'next'
        ? sourceIndex
        : targetIndex
      : direction === 'next'
        ? sourceIndex + 1
        : sourceIndex;

    isAnimating = true;
    setBookBusy(true);
    updateControls();
    prepareReveal(targetIndex, direction);
    const turn = createTurningLeaf(turningPage, direction);
    if (!turn || !motionHost) {
      isAnimating = false;
      setBookBusy(false);
      commitPage(targetIndex, true);
      return;
    }

    const token = ++motionToken;
    let fallbackTimer = 0;

    const finish = () => {
      if (activeTurn?.token !== token) return;
      window.clearTimeout(fallbackTimer);
      turn.removeEventListener('animationend', onAnimationEnd);
      motionHost.replaceChildren();
      delete motionHost.dataset.direction;
      activeTurn = null;
      isAnimating = false;
      setBookBusy(false);
      commitPage(targetIndex, true);
    };

    const onAnimationEnd = (event: AnimationEvent) => {
      if (event.target === turn) finish();
    };

    activeTurn = { token, finish };
    turn.addEventListener('animationend', onAnimationEnd);
    fallbackTimer = window.setTimeout(finish, TURN_DURATION_MS + 180);

    window.requestAnimationFrame(() => {
      if (activeTurn?.token !== token) return;
      turn.classList.add('is-turning');
      motionHost.querySelector('.album-turn-shadow')?.classList.add('is-moving');
    });
  }

  function navigate(direction: 'next' | 'prev') {
    navigateTo(currentPage + (direction === 'next' ? 1 : -1), direction);
  }

  function measureSummarySlot() {
    if (!summaryHud || !summarySlot) return;
    const activeMode = summaryHud.classList.contains('is-album-hud')
      ? 'is-album-hud'
      : summaryHud.classList.contains('is-grid-hud')
        ? 'is-grid-hud'
        : null;
    const wasStatic = summaryHud.classList.contains('is-static-hud');
    summaryHud.classList.add('is-measuring');
    summaryHud.classList.remove('is-album-hud', 'is-grid-hud', 'is-static-hud');
    summarySlot.style.height = 'auto';
    summarySlot.style.height = `${summaryHud.getBoundingClientRect().height}px`;
    if (activeMode) summaryHud.classList.add(activeMode);
    if (wasStatic) summaryHud.classList.add('is-static-hud');
    summaryHud.classList.remove('is-measuring');
  }

  const summaryMotionProperties = [
    '--summary-opacity',
    '--summary-x',
    '--summary-y',
    '--summary-mobile-y',
    '--summary-scale',
  ];

  function resetSummaryHud() {
    if (!summaryHud) return;
    summaryHud.classList.remove('is-album-hud', 'is-grid-hud', 'is-static-hud');
    bookView?.classList.remove('has-story-hud');
    for (const property of summaryMotionProperties) summaryHud.style.removeProperty(property);
    clearHudTitle();
  }

  function clearHudTitle() {
    if (!hudTitle) return;
    hudTitle.hidden = true;
    hudTitle.textContent = '';
  }

  function setGridHudTitle(visible: boolean) {
    if (!hudTitle) return;
    hudTitle.textContent = 'Cien citas, una misma historia';
    hudTitle.hidden = !visible;
  }

  function setAlbumHudActive(active: boolean, progress = 0) {
    if (!summaryHud) return;
    if (!active) {
      if (summaryHud.classList.contains('is-album-hud')) resetSummaryHud();
      return;
    }

    const entrance = clamp(progress, 0, 1);
    summaryHud.classList.remove('is-grid-hud');
    summaryHud.classList.add('is-album-hud');
    summaryHud.classList.toggle('is-static-hud', reducedMotionQuery.matches);
    bookView?.classList.add('has-story-hud');
    clearHudTitle();

    summaryHud.style.setProperty('--summary-opacity', `${lerp(0, 1, entrance)}`);
    summaryHud.style.setProperty('--summary-x', `${lerp(-2.8, 0, entrance)}rem`);
    summaryHud.style.setProperty('--summary-y', `${lerp(6, 0, entrance)}rem`);
    summaryHud.style.setProperty('--summary-mobile-y', `${lerp(-1.5, 0, entrance)}rem`);
    summaryHud.style.setProperty('--summary-scale', `${lerp(0.88, 1, entrance)}`);
  }

  function setGridHudActive(active: boolean, progress = 0, settled = false) {
    if (!summaryHud) return;
    if (!active) {
      if (summaryHud.classList.contains('is-grid-hud')) resetSummaryHud();
      return;
    }

    const entrance = clamp(progress, 0, 1);
    summaryHud.classList.remove('is-album-hud', 'is-static-hud');
    summaryHud.classList.add('is-grid-hud');
    bookView?.classList.remove('has-story-hud');
    setGridHudTitle(settled);
    summaryHud.style.setProperty('--summary-opacity', `${lerp(0, 1, entrance)}`);
    summaryHud.style.setProperty('--summary-x', `${lerp(2.4, 0, entrance)}rem`);
    summaryHud.style.setProperty('--summary-y', `${lerp(-1.2, 0, entrance)}rem`);
    summaryHud.style.setProperty('--summary-mobile-y', `${lerp(-1.2, 0, entrance)}rem`);
    summaryHud.style.setProperty('--summary-scale', `${lerp(0.94, 1, entrance)}`);
  }

  function storyIsEnabled() {
    return (
      isBookActive() &&
      !reducedMotionQuery.matches &&
      bookView?.dataset.storyEnabled === 'true' &&
      Boolean(albumStory && albumScene)
    );
  }

  function updateStoryAct(progress: number) {
    const act =
      progress < ALBUM_RAIL_ACT_TWO_START ? 1 : progress < ALBUM_RAIL_ACT_THREE_START ? 2 : 3;
    const labels = ['La historia comienza', 'El álbum toma el centro', 'Seguimos escribiendo'];
    albumScene?.setAttribute('data-active-act', String(act));
    if (storyActLabel) storyActLabel.textContent = labels[act - 1] ?? 'La historia comienza';
    if (storyActNumber) storyActNumber.textContent = padNumber(act);
    for (const marker of storyActMarkers) {
      marker.classList.toggle('is-active', marker.dataset.storyAct === String(act));
    }
  }

  function getAlbumFramingScale() {
    return !mobileQuery.matches && window.innerHeight <= 832 ? 0.92 : 1;
  }

  function applyStoryPresentation(progress: number) {
    if (!albumScene) return;
    const normalized = clamp(progress, 0, 1);
    const framingScale = getAlbumFramingScale();
    const actOne = clamp(normalized / ALBUM_VISUAL_ACT_TWO_START, 0, 1);
    const actTwo = clamp(
      (normalized - ALBUM_VISUAL_ACT_TWO_START) /
        (ALBUM_VISUAL_ACT_THREE_START - ALBUM_VISUAL_ACT_TWO_START),
      0,
      1,
    );
    const actThree = clamp(
      (normalized - ALBUM_VISUAL_ACT_THREE_START) /
        (1 - ALBUM_VISUAL_ACT_THREE_START),
      0,
      1,
    );

    let scale = lerp(0.68, 0.82, actOne);
    let shiftY = lerp(10, 5, actOne);
    let depth = lerp(-8, -3, actOne);
    let rotateX = lerp(17, 10, actOne);
    let rotateZ = lerp(-2.2, -1, actOne);
    let shadowOpacity = lerp(0.92, 0.82, actOne);
    let shadowScale = lerp(1.16, 1.02, actOne);
    let shadowBlur = lerp(25, 18, actOne);

    if (normalized >= ALBUM_VISUAL_ACT_TWO_START) {
      scale = lerp(0.82, framingScale, actTwo);
      shiftY = lerp(5, 0, actTwo);
      depth = lerp(-3, 0, actTwo);
      rotateX = lerp(10, 1.5, actTwo);
      rotateZ = lerp(-1, 0, actTwo);
      shadowOpacity = lerp(0.82, 0.64, actTwo);
      shadowScale = lerp(1.02, 0.82, actTwo);
      shadowBlur = lerp(18, 11, actTwo);
    }

    if (normalized >= ALBUM_VISUAL_ACT_THREE_START) {
      scale = framingScale;
      shiftY = lerp(0, 3, actThree);
      depth = lerp(0, 2.2, actThree);
      rotateX = lerp(1.5, 0.35, actThree);
      rotateZ = lerp(0, 0.18, actThree);
      shadowOpacity = lerp(0.64, 0.54, actThree);
      shadowScale = lerp(0.82, 0.74, actThree);
      shadowBlur = lerp(11, 9, actThree);
    }

    if (mobileQuery.matches) scale *= 0.94;

    const controlsClarity = clamp((normalized - 0.16) / 0.42, 0, 1);
    const closingOpacity = clamp((normalized - 0.72) / 0.15, 0, 1);
    const openingOpacity = 1 - clamp((normalized - 0.12) / 0.3, 0, 1);
    const phraseExit = clamp((normalized - 0.03) / 0.44, 0, 1);
    const phraseDrifts = [
      { x: -2.8, y: -1.2 },
      { x: 2.2, y: -1.8 },
      { x: -1.7, y: 2.4 },
      { x: 3.1, y: 1.4 },
    ];

    albumScene.style.setProperty('--album-scale', `${scale}`);
    albumScene.style.setProperty('--album-shift-y', `${shiftY}dvh`);
    albumScene.style.setProperty('--album-depth', `${depth}rem`);
    albumScene.style.setProperty('--album-rotate-x', `${rotateX}deg`);
    albumScene.style.setProperty('--album-rotate-z', `${rotateZ}deg`);
    albumScene.style.setProperty('--story-light-x', `${lerp(18, 82, normalized)}%`);
    albumScene.style.setProperty('--album-light-shift', `${lerp(-72, 72, normalized)}%`);
    albumScene.style.setProperty('--album-light-opacity', `${lerp(0.08, 0.34, actTwo)}`);
    albumScene.style.setProperty('--shadow-opacity', `${shadowOpacity}`);
    albumScene.style.setProperty('--shadow-scale', `${shadowScale}`);
    albumScene.style.setProperty('--shadow-blur', `${shadowBlur}px`);
    albumScene.style.setProperty('--paper-brightness', `${lerp(1, 1.07, actThree)}`);
    albumScene.style.setProperty('--paper-sepia', `${lerp(0, 0.14, actThree)}`);
    albumScene.style.setProperty('--controls-opacity', `${lerp(0.68, 1, controlsClarity)}`);
    albumScene.style.setProperty('--controls-y', `${lerp(0.45, 0, controlsClarity)}rem`);
    albumScene.style.setProperty('--folio-opacity', `${lerp(0.58, 1, controlsClarity)}`);
    albumScene.style.setProperty('--opening-opacity', `${openingOpacity}`);
    albumScene.style.setProperty('--opening-y', `${lerp(0, -5.5, normalized)}rem`);
    albumScene.style.setProperty('--closing-opacity', `${closingOpacity}`);
    albumScene.style.setProperty('--closing-y', `${lerp(3.2, -0.8, closingOpacity)}rem`);
    albumScene.style.setProperty('--phrase-opacity', `${1 - phraseExit}`);
    for (const [index, phrase] of storyPhrases.entries()) {
      const drift = phraseDrifts[index] ?? { x: 0, y: 0 };
      phrase.style.setProperty('--phrase-x', `${lerp(0, drift.x, phraseExit)}rem`);
      phrase.style.setProperty('--phrase-y', `${lerp(0, drift.y, phraseExit)}rem`);
    }
  }

  function clearStoryPresentation() {
    setAlbumHudActive(false);
    resetAlbumQuoteCycle();
    if (!albumScene) return;
    for (const property of [
      '--story-progress',
      '--album-scale',
      '--album-shift-y',
      '--album-depth',
      '--album-rotate-x',
      '--album-rotate-z',
      '--story-light-x',
      '--album-light-shift',
      '--album-light-opacity',
      '--shadow-opacity',
      '--shadow-scale',
      '--shadow-blur',
      '--paper-brightness',
      '--paper-sepia',
      '--controls-opacity',
      '--controls-y',
      '--folio-opacity',
      '--opening-opacity',
      '--opening-y',
      '--closing-opacity',
      '--closing-y',
      '--phrase-opacity',
    ]) {
      albumScene.style.removeProperty(property);
    }
    for (const phrase of storyPhrases) {
      phrase.style.removeProperty('--phrase-x');
      phrase.style.removeProperty('--phrase-y');
    }
    albumScene.removeAttribute('data-active-act');
    if (storyActLabel) storyActLabel.textContent = 'La historia comienza';
    if (storyActNumber) storyActNumber.textContent = '01';
    for (const marker of storyActMarkers) {
      marker.classList.toggle('is-active', marker.dataset.storyAct === '1');
    }
  }

  function readStoryProgress() {
    if (!albumStory || !albumScene) {
      return { progress: 0, rect: null, sceneHeight: window.innerHeight };
    }
    const rect = albumStory.getBoundingClientRect();
    const sceneHeight = albumScene.getBoundingClientRect().height || window.innerHeight;
    const scrollRange = Math.max(albumStory.offsetHeight - sceneHeight, 1);
    return {
      progress: clamp(-rect.top / scrollRange, 0, 1),
      rect,
      sceneHeight,
    };
  }

  function updateStoryFrame() {
    storyFrame = 0;
    if (!storyIsEnabled()) {
      clearStoryPresentation();
      if (isBookActive() && reducedMotionQuery.matches && albumStory) {
        const rect = albumStory.getBoundingClientRect();
        const viewportHeight = Math.max(window.innerHeight, 1);
        const hudActive = rect.top < viewportHeight * 0.74 && rect.bottom > viewportHeight * 0.18;
        setAlbumHudActive(hudActive, 1);
      }
      return;
    }

    const { progress: rawStoryProgress, rect, sceneHeight } = readStoryProgress();
    if (!rect) return;
    const presentationProgress = rawStoryProgress * ALBUM_PRESENTATION_LIMIT;
    albumScene.style.setProperty('--story-progress', `${rawStoryProgress}`);
    applyStoryPresentation(presentationProgress);
    updateStoryAct(rawStoryProgress);
    updateAlbumQuoteCycle(rawStoryProgress);

    const entryDistance = Math.max(sceneHeight * 0.35, 1);
    const exitDistance = Math.max(sceneHeight * 0.55, 1);
    const entryProgress = clamp(1 - rect.top / entryDistance, 0, 1);
    const exitProgress = clamp(rect.bottom / exitDistance, 0, 1);
    const summaryProgress = Math.min(entryProgress, exitProgress);
    setAlbumHudActive(summaryProgress > 0, summaryProgress);
  }

  function requestStoryUpdate() {
    if (storyFrame) return;
    storyFrame = window.requestAnimationFrame(updateStoryFrame);
  }

  function isBookActive() {
    return bookView?.getAttribute('aria-hidden') === 'false';
  }

  function isGridViewActive() {
    return gridView?.getAttribute('aria-hidden') === 'false';
  }

  function preserveGridScrollPositionDuring(mutation: () => void) {
    if (!isGridViewActive()) {
      mutation();
      return;
    }

    const scrollLeft = window.scrollX;
    const scrollTop = window.scrollY;
    mutation();
    void gridView?.offsetHeight;

    if (window.scrollX !== scrollLeft || window.scrollY !== scrollTop) {
      window.scrollTo(scrollLeft, scrollTop);
    }
  }

  function createRandomGridQuoteOrder() {
    const quoteOrder = [...initialGridQuotePhrases];
    for (let index = quoteOrder.length - 1; index > 0; index -= 1) {
      const randomIndex = Math.floor(Math.random() * (index + 1));
      [quoteOrder[index], quoteOrder[randomIndex]] = [quoteOrder[randomIndex], quoteOrder[index]];
    }
    return quoteOrder;
  }

  function createGridQuoteTiles() {
    if (!gridView || gridQuoteTiles.length) return;
    const quoteOrder = createRandomGridQuoteOrder();
    const quoteElements = Array.from(gridView.querySelectorAll<HTMLElement>('.grid-quote'));

    gridQuoteTiles = quoteElements.flatMap((tile, index) => {
      const afterCard = Number.parseInt(tile.dataset.afterCard ?? '', 10);
      const phrase = quoteOrder[index];
      const text = tile.querySelector<HTMLElement>('p');
      if (!Number.isInteger(afterCard) || !phrase || !text) return [];

      text.textContent = phrase;

      return [{ element: tile, afterCard }];
    });
  }

  function getVisibleGridItems() {
    if (!gridView) return [];
    return Array.from(gridView.children).filter(
      (element): element is HTMLElement =>
        element instanceof HTMLElement &&
        !element.hidden &&
        (element.classList.contains('date-card') || element.classList.contains('grid-quote')),
    );
  }

  function measureGridMasonryItems() {
    gridMasonryFrame = 0;
    if (!gridView || !isGridViewActive()) return;

    const visibleItems = getVisibleGridItems();
    if (!visibleItems.length) return;
    const shouldRestoreScrollPosition = performance.now() < gridMasonryScrollRestoreUntil;

    const measureItems = () => {
      const gridStyles = window.getComputedStyle(gridView);
      const rowHeight = Number.parseFloat(gridStyles.gridAutoRows) || GRID_MASONRY_ROW_PX;
      const rowGap = Number.parseFloat(gridStyles.rowGap) || 0;
      const rowStride = rowHeight + rowGap;

      for (const element of visibleItems) element.style.removeProperty('grid-row-end');
      const measurements = visibleItems.map((element) => ({
        element,
        span: Math.max(1, Math.ceil((element.offsetHeight + rowGap) / rowStride)),
      }));

      gridMeasuredWidth = gridView.getBoundingClientRect().width;
      for (const { element, span } of measurements) {
        const nextSpan = `span ${span}`;
        if (element.style.gridRowEnd !== nextSpan) element.style.gridRowEnd = nextSpan;
      }

      for (const element of pendingGridRevealElements) {
        if (element.hidden) continue;
        element.classList.remove('is-grid-item-measuring');
        if (!reducedMotionQuery.matches) element.classList.add('is-grid-batch-revealed');
        pendingGridRevealElements.delete(element);
      }
    };

    if (shouldRestoreScrollPosition) preserveGridScrollPositionDuring(measureItems);
    else measureItems();
  }

  function scheduleGridMasonryMeasurement(preserveScrollPosition = false) {
    if (!isGridViewActive()) return;
    if (preserveScrollPosition) {
      gridMasonryScrollRestoreUntil = performance.now() + 100;
    }
    if (gridMasonryFrame || !isGridViewActive()) return;
    gridMasonryFrame = window.requestAnimationFrame(measureGridMasonryItems);
  }

  function connectGridMasonryMeasurements() {
    if (!gridView || gridResizeObserverConnected) return;
    if (!gridResizeObserver && typeof window.ResizeObserver === 'function') {
      gridResizeObserver = new ResizeObserver((entries) => {
        let shouldMeasure = false;
        for (const entry of entries) {
          if (entry.target === gridView) {
            if (Math.abs(entry.contentRect.width - gridMeasuredWidth) >= 0.5) {
              gridMeasuredWidth = entry.contentRect.width;
              shouldMeasure = true;
            }
          } else if (entry.target instanceof HTMLElement && !entry.target.hidden) {
            shouldMeasure = true;
          }
        }
        if (shouldMeasure) scheduleGridMasonryMeasurement();
      });
    }
    if (!gridResizeObserver) return;

    gridResizeObserverConnected = true;
    gridResizeObserver.observe(gridView);
    for (const element of getVisibleGridItems()) gridResizeObserver.observe(element);
  }

  function cancelGridMasonryMeasurement() {
    if (gridMasonryFrame) window.cancelAnimationFrame(gridMasonryFrame);
    gridMasonryFrame = 0;
    gridMasonryScrollRestoreUntil = 0;
  }

  function stopGridMasonryMeasurements() {
    cancelGridMasonryMeasurement();
    gridResizeObserver?.disconnect();
    gridResizeObserverConnected = false;
  }

  function revealGridElement(element: HTMLElement, delayIndex: number) {
    element.hidden = false;
    element.classList.add('is-grid-item-measuring');
    element.style.setProperty(
      '--grid-wave-delay',
      `${reducedMotionQuery.matches ? 0 : Math.min(delayIndex, 9) * 38}ms`,
    );
    pendingGridRevealElements.add(element);
    if (gridResizeObserverConnected) gridResizeObserver?.observe(element);
  }

  function disconnectGridBatchObserver() {
    gridSentinelArmed = false;
    gridBatchObserver?.disconnect();
    gridBatchObserver = null;
  }

  function handleGridFallbackViewportChange() {
    scheduleGridSentinelSync();
  }

  function startGridFallbackListeners() {
    if (gridFallbackListening) return;
    gridFallbackListening = true;
    window.addEventListener('scroll', handleGridFallbackViewportChange, { passive: true });
    window.addEventListener('resize', handleGridFallbackViewportChange, { passive: true });
  }

  function stopGridFallbackListeners() {
    if (!gridFallbackListening) return;
    gridFallbackListening = false;
    window.removeEventListener('scroll', handleGridFallbackViewportChange);
    window.removeEventListener('resize', handleGridFallbackViewportChange);
  }

  function stopGridSentinelLifecycle() {
    disconnectGridBatchObserver();
    stopGridFallbackListeners();
    if (gridBatchFrame) window.cancelAnimationFrame(gridBatchFrame);
    if (gridSentinelSyncFrame) window.cancelAnimationFrame(gridSentinelSyncFrame);
    gridBatchFrame = 0;
    gridSentinelSyncFrame = 0;
  }

  function gridFeedCanLoad() {
    return Boolean(
      gridFeedSentinel &&
        !gridFeedSentinel.hidden &&
        isGridViewActive() &&
        revealedGridCardCount < gridCards.length,
    );
  }

  function gridSentinelIsNearViewport() {
    if (!gridFeedSentinel || !gridFeedCanLoad()) return false;
    const rect = gridFeedSentinel.getBoundingClientRect();
    const viewportHeight = Math.max(document.documentElement.clientHeight, window.innerHeight, 1);
    return rect.width > 0 && rect.height > 0 && rect.top <= viewportHeight + GRID_LOAD_AHEAD_PX && rect.bottom >= 0;
  }

  function disarmGridSentinelObserver() {
    gridSentinelArmed = false;
    if (!gridBatchObserver || !gridFeedSentinel) return;
    gridBatchObserver.unobserve(gridFeedSentinel);
    gridBatchObserver.takeRecords();
  }

  function ensureGridBatchObserver() {
    if (gridBatchObserver) return true;
    if (typeof window.IntersectionObserver !== 'function') return false;

    try {
      gridBatchObserver = new IntersectionObserver(
        (entries) => {
          if (
            !gridSentinelArmed ||
            !gridFeedCanLoad() ||
            !entries.some((entry) => entry.isIntersecting)
          ) {
            return;
          }
          disarmGridSentinelObserver();
          scheduleNextGridBatch();
        },
        {
          root: null,
          rootMargin: `0px 0px ${GRID_LOAD_AHEAD_PX}px 0px`,
          threshold: 0.01,
        },
      );
    } catch {
      gridBatchObserver = null;
      return false;
    }

    return true;
  }

  function scheduleNextGridBatch() {
    if (gridBatchFrame || !gridFeedCanLoad()) return;
    disarmGridSentinelObserver();
    gridBatchFrame = window.requestAnimationFrame(() => {
      gridBatchFrame = 0;
      if (!gridFeedCanLoad()) return;
      revealNextGridBatch();
      if (gridFeedCanLoad()) scheduleGridSentinelSync();
    });
  }

  function scheduleGridSentinelSync() {
    if (gridSentinelSyncFrame || !gridFeedCanLoad()) return;
    gridSentinelSyncFrame = window.requestAnimationFrame(() => {
      gridSentinelSyncFrame = 0;
      if (!gridFeedCanLoad()) return;

      const observerAvailable = ensureGridBatchObserver();
      if (observerAvailable) stopGridFallbackListeners();
      else startGridFallbackListeners();

      if (gridSentinelIsNearViewport()) {
        scheduleNextGridBatch();
        return;
      }

      if (observerAvailable && gridBatchObserver && gridFeedSentinel && !gridSentinelArmed) {
        gridBatchObserver.observe(gridFeedSentinel);
        gridSentinelArmed = true;
      }
    });
  }

  function updateGridFeedStatus() {
    if (!gridFeedStatus || !gridFeedCount) return;
    const total = gridCards.length;
    const isComplete = revealedGridCardCount >= total;
    gridFeedStatus.hidden = false;
    gridFeedCount.textContent = `Mostrando ${revealedGridCardCount} de ${total} citas`;
    if (gridFeedSentinel) gridFeedSentinel.hidden = isComplete;
    if (gridFeedEnd) gridFeedEnd.hidden = !isComplete;
    if (isComplete) stopGridSentinelLifecycle();
  }

  function revealGridRange(start: number, end: number) {
    const safeEnd = Math.min(end, gridCards.length);
    const preserveScrollPosition = start > 0 && isGridViewActive();
    const revealRange = () => {
      let delayIndex = 0;

      for (let index = start; index < safeEnd; index += 1) {
        const card = gridCards[index];
        if (!card) continue;
        revealGridElement(card, delayIndex);
        delayIndex += 1;
      }

      for (const quote of gridQuoteTiles) {
        if (quote.afterCard > safeEnd || !quote.element.hidden) continue;
        revealGridElement(quote.element, delayIndex);
        delayIndex += 1;
      }

      revealedGridCardCount = safeEnd;
      updateGridFeedStatus();
      scheduleGridMasonryMeasurement(preserveScrollPosition);
      requestGridUpdate();
    };

    if (preserveScrollPosition) preserveGridScrollPositionDuring(revealRange);
    else revealRange();
  }

  function initializeGridFeed() {
    if (gridFeedInitialized || !gridArchive || !gridView || !gridCards.length) return;
    gridFeedInitialized = true;
    createGridQuoteTiles();
    gridArchive.classList.add('is-grid-enhanced');

    for (const card of gridCards) card.hidden = true;
    for (const quote of gridQuoteTiles) quote.element.hidden = true;
    connectGridMasonryMeasurements();
    revealGridRange(0, Math.min(GRID_INITIAL_BATCH_SIZE, gridCards.length));
  }

  function revealNextGridBatch() {
    if (revealedGridCardCount >= gridCards.length) return;
    revealGridRange(revealedGridCardCount, revealedGridCardCount + GRID_BATCH_SIZE);
  }

  function clearGridExperience() {
    stopGridSentinelLifecycle();
    cancelGridMasonryMeasurement();
    if (gridFrame) window.cancelAnimationFrame(gridFrame);
    gridFrame = 0;
    gridArchive?.classList.remove('is-grid-active');
    for (const property of ['--grid-progress', '--grid-depth-y', '--grid-light-x']) {
      gridArchive?.style.removeProperty(property);
    }
    setGridHudActive(false);
  }

  function prepareGridExperience() {
    clearGridExperience();
    initializeGridFeed();
    if (!gridArchive || !gridView || !isGridViewActive()) return;
    connectGridMasonryMeasurements();
    scheduleGridMasonryMeasurement();
    scheduleGridSentinelSync();
  }

  function updateGridFrame() {
    gridFrame = 0;
    if (!gridArchive || !isGridViewActive()) return;

    const rect = gridArchive.getBoundingClientRect();
    const viewportHeight = Math.max(window.innerHeight, 1);
    const progress = clamp(
      (viewportHeight - rect.top) / Math.max(rect.height + viewportHeight, 1),
      0,
      1,
    );
    const entryProgress = clamp(
      (viewportHeight * 0.82 - rect.top) / Math.max(viewportHeight * 0.52, 1),
      0,
      1,
    );
    const hudActive = rect.top < viewportHeight * 0.82 && rect.bottom > viewportHeight * 0.16;

    gridArchive.style.setProperty('--grid-progress', `${progress}`);
    gridArchive.style.setProperty('--grid-depth-y', `${lerp(1.4, -1.4, progress)}rem`);
    gridArchive.style.setProperty('--grid-light-x', `${lerp(18, 82, progress)}%`);
    gridArchive.classList.toggle('is-grid-active', hudActive);
    setGridHudActive(
      hudActive,
      reducedMotionQuery.matches ? 1 : entryProgress,
      reducedMotionQuery.matches ? hudActive : entryProgress >= 0.98,
    );
  }

  function requestGridUpdate() {
    if (gridFrame || !isGridViewActive()) return;
    gridFrame = window.requestAnimationFrame(updateGridFrame);
  }

  type CollectionView = 'grid' | 'book';

  interface CollectionViewOptions {
    announce?: boolean;
  }

  function setCollectionView(
    view: CollectionView,
    { announce = true }: CollectionViewOptions = {},
  ) {
    if (!gridView || !bookView || !gridBtn || !bookBtn) return;

    const showBook = view === 'book';
    const wasBookActive = isBookActive();
    clearAlbumPointerDrag();
    if (!showBook) {
      activeTurn?.finish();
      clearStoryPresentation();
    } else {
      clearGridExperience();
    }
    measureSummarySlot();

    if (showBook) gridView.style.display = 'none';
    else gridView.style.removeProperty('display');
    if (gridArchive) gridArchive.style.display = showBook ? 'none' : 'grid';
    bookView.style.display = showBook ? 'block' : 'none';
    bookView.dataset.storyEnabled = String(showBook && !reducedMotionQuery.matches);
    gridBtn.classList.toggle('view-btn--active', !showBook);
    bookBtn.classList.toggle('view-btn--active', showBook);
    gridBtn.setAttribute('aria-pressed', String(!showBook));
    bookBtn.setAttribute('aria-pressed', String(showBook));
    gridView.setAttribute('aria-hidden', String(showBook));
    bookView.setAttribute('aria-hidden', String(!showBook));

    if (!showBook) {
      prepareGridExperience();
      requestGridUpdate();
      if (announce && liveStatus) liveStatus.textContent = 'Vista cuadrícula.';
      return;
    }

    if (wasBookActive) {
      requestStoryUpdate();
      if (announce && liveStatus) {
        liveStatus.textContent = `Vista álbum. ${getStatus(currentPage)}`;
      }
      return;
    }

    commitPage(currentPage);
    requestStoryUpdate();
    if (announce && liveStatus) liveStatus.textContent = `Vista álbum. ${getStatus(currentPage)}`;
  }

  gridBtn?.addEventListener('click', () => setCollectionView('grid'));
  bookBtn?.addEventListener('click', () => setCollectionView('book'));

  prevBtn?.addEventListener('click', () => navigate('prev'));
  nextBtn?.addEventListener('click', () => navigate('next'));

  const clearGridRevealAnimation = (event: AnimationEvent) => {
    if (!(event.target instanceof HTMLElement)) return;
    event.target.classList.remove('is-grid-batch-revealed');
  };
  gridView?.addEventListener('animationend', clearGridRevealAnimation);
  gridView?.addEventListener('animationcancel', clearGridRevealAnimation);

  window.addEventListener('keydown', (event) => {
    if (
      !isBookActive() ||
      event.altKey ||
      event.ctrlKey ||
      event.metaKey ||
      event.shiftKey ||
      (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight')
    ) {
      return;
    }

    const target = event.target;
    if (
      target instanceof Element &&
      target.closest(
        'input, textarea, select, button, [contenteditable]:not([contenteditable="false"])',
      )
    ) {
      return;
    }

    const direction = event.key === 'ArrowRight' ? 'next' : 'prev';
    const targetIndex = currentPage + (direction === 'next' ? 1 : -1);
    if (targetIndex < 0 || targetIndex >= totalBookPages || isAnimating) return;
    event.preventDefault();
    navigate(direction);
  });

  const ALBUM_INTERACTIVE_SELECTOR =
    'button, a, input, textarea, select, option, label, [role="button"], [role="link"], [contenteditable]:not([contenteditable="false"])';
  let pointerStart: { id: number; x: number; y: number } | null = null;

  function clearAlbumPointerDrag(pointerId = pointerStart?.id, releaseCapture = true) {
    pointerStart = null;
    albumStage?.classList.remove('is-pointer-dragging');
    if (
      releaseCapture &&
      pointerId !== undefined &&
      albumStage?.hasPointerCapture(pointerId)
    ) {
      albumStage.releasePointerCapture(pointerId);
    }
  }

  albumStage?.addEventListener('pointerdown', (event) => {
    if (!isBookActive() || isAnimating || !event.isPrimary || event.button !== 0) return;
    if (event.target instanceof Element && event.target.closest(ALBUM_INTERACTIVE_SELECTOR)) {
      return;
    }
    pointerStart = { id: event.pointerId, x: event.clientX, y: event.clientY };
    albumStage.setPointerCapture(event.pointerId);
    albumStage.classList.add('is-pointer-dragging');
  });

  albumStage?.addEventListener('pointerup', (event) => {
    if (!pointerStart || pointerStart.id !== event.pointerId) return;
    const dragStart = pointerStart;
    const deltaX = event.clientX - dragStart.x;
    const deltaY = event.clientY - dragStart.y;
    clearAlbumPointerDrag(event.pointerId);

    if (Math.abs(deltaX) < 48 || Math.abs(deltaX) <= Math.abs(deltaY)) return;
    navigate(deltaX < 0 ? 'next' : 'prev');
  });

  albumStage?.addEventListener('pointercancel', (event) => {
    clearAlbumPointerDrag(event.pointerId);
  });

  albumStage?.addEventListener('lostpointercapture', (event) => {
    clearAlbumPointerDrag(event.pointerId, false);
  });

  albumStage?.addEventListener('dragstart', (event) => event.preventDefault());

  reducedMotionQuery.addEventListener('change', () => {
    activeTurn?.finish();
    if (reducedMotionQuery.matches) {
      for (const element of getVisibleGridItems()) {
        element.classList.remove('is-grid-batch-revealed');
      }
    }
    bookView?.style.setProperty(
      '--turn-duration',
      `${reducedMotionQuery.matches ? 0 : TURN_DURATION_MS}ms`,
    );
    bookView?.setAttribute('data-story-enabled', String(isBookActive() && !reducedMotionQuery.matches));
    clearStoryPresentation();
    if (isBookActive()) {
      requestStoryUpdate();
    } else {
      prepareGridExperience();
      requestGridUpdate();
    }
  });

  window.addEventListener('pagehide', () => {
    resetAlbumQuoteCycle();
    stopGridSentinelLifecycle();
    stopGridMasonryMeasurements();
  });
  window.addEventListener('pageshow', () => {
    if (isBookActive()) requestStoryUpdate();
    else prepareGridExperience();
  });

  window.addEventListener(
    'scroll',
    () => {
      if (isBookActive()) requestStoryUpdate();
      else requestGridUpdate();
    },
    { passive: true },
  );

  window.addEventListener('resize', () => {
    clearAlbumPointerDrag();
    activeTurn?.finish();
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => {
      measureSummarySlot();
      renderStaticSpread(currentPage);
      updateStatus(currentPage);
      updateControls();
      if (isBookActive()) {
        requestStoryUpdate();
      } else {
        scheduleGridMasonryMeasurement();
        requestGridUpdate();
      }
    }, 120);
  });

  measureSummarySlot();
  bookView?.style.setProperty(
    '--turn-duration',
    `${reducedMotionQuery.matches ? 0 : TURN_DURATION_MS}ms`,
  );
  commitPage(0);
  setCollectionView('book', { announce: false });
  initializeGridFeed();
  document.fonts?.ready.then(() => {
    measureSummarySlot();
    scheduleGridMasonryMeasurement();
  });

  // --- Logout ---
  const logoutBtn = document.getElementById('logout-btn');
  logoutBtn?.addEventListener('click', async () => {
    await fetch('/api/auth/logout', { method: 'POST' });
    window.location.href = '/login';
  });
</script>

